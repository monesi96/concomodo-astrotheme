{%- comment -%}
  Landing "Offerte di lancio": hero con materasso che si apre a strati,
  iscrizione newsletter (codice di benvenuto), offerte, FAQ e chiusa con iscrizione.
  Dopo l'iscrizione mostra il codice e rimanda alla home.
{%- endcomment -%}

{%- liquid
  assign n_layers = 0
  for i in (1..5)
    assign key = 'layer_' | append: i
    if section.settings[key] != blank
      assign n_layers = n_layers | plus: 1
    endif
  endfor
  assign redirect_url = section.settings.redirect_url | default: routes.root_url
-%}

<style>
  #ol-{{ section.id }}{--av:#F4EFE8;--ink:#23272C;--cel:#B2C8D1;--ecru:#E4DED6;--mid:#464646;font-family:var(--font-body--family);color:var(--ink);margin:0 auto;max-width:1180px;padding:0 20px}
  #ol-{{ section.id }} *{box-sizing:border-box}
  #ol-{{ section.id }} h1,#ol-{{ section.id }} h2,#ol-{{ section.id }} .ol-d,#ol-{{ section.id }} summary,#ol-{{ section.id }} button,#ol-{{ section.id }} .ol-btn{font-family:var(--font-heading--family);letter-spacing:-.02em;margin:0}
  #ol-{{ section.id }} .ol-hero{position:relative;overflow:hidden;border-radius:32px;background:radial-gradient(120% 80% at 50% 10%,#2E343B 0%,#1C2025 60%,#15181C 100%);color:var(--av);padding:64px 28px 56px;text-align:center;margin-top:24px}
  #ol-{{ section.id }} .ol-hero h1{font-size:clamp(44px,7vw,88px);font-weight:900;line-height:.98;color:var(--av)}
  #ol-{{ section.id }} .ol-hero h1 span{color:var(--cel);display:block}
  #ol-{{ section.id }} .ol-hero .ol-lead{max-width:620px;margin:22px auto 0;font-size:19px;line-height:1.55;color:#E4DED6}
  #ol-{{ section.id }} .ol-hero .ol-lead p{margin:0}
  #ol-{{ section.id }} .ol-mat{position:relative;pointer-events:none;width:min(600px,96%);aspect-ratio:1200 / 980;margin:30px auto 0}
  #ol-{{ section.id }} .ol-ly{position:absolute;inset:0}
  #ol-{{ section.id }} .ol-ly img{position:absolute;left:0;width:100%;height:auto;max-width:none;display:block;transform-origin:50% 50%;animation:olOpen 7s cubic-bezier(.65,0,.35,1) var(--d) infinite both;will-change:transform,opacity}
  @keyframes olOpen{0%,12%{transform:translateY(var(--c)) scaleY(var(--s));opacity:var(--a)}32%,70%{transform:none;opacity:1}88%,100%{transform:translateY(var(--c)) scaleY(var(--s));opacity:var(--a)}}
  @media (prefers-reduced-motion:reduce){#ol-{{ section.id }} .ol-ly img{animation:none}}
  #ol-{{ section.id }} form{max-width:560px;margin:24px auto 0;position:relative;z-index:20}
  #ol-{{ section.id }} .ol-row{display:flex;gap:10px;flex-wrap:wrap;justify-content:center}
  #ol-{{ section.id }} input[type=email]{flex:1 1 280px;border:0;border-radius:999px;padding:18px 24px;font-size:17px;font-family:inherit;color:var(--ink);background:var(--av);min-width:0}
  #ol-{{ section.id }} button,#ol-{{ section.id }} .ol-btn{border:0;border-radius:999px;padding:18px 30px;font-size:17px;font-weight:800;background:var(--cel);color:var(--ink);cursor:pointer;text-decoration:none;display:inline-block}
  #ol-{{ section.id }} .ol-small{font-size:13px;color:#CBC4BC;margin-top:12px;line-height:1.5}
  #ol-{{ section.id }} .ol-small a{color:inherit}
  #ol-{{ section.id }} .ol-err{color:#F2B8B5;font-size:14px;margin-top:10px}
  #ol-{{ section.id }} .ol-code{background:var(--av);color:var(--ink);border-radius:24px;padding:24px;text-align:center}
  #ol-{{ section.id }} .ol-code b{font-family:var(--font-heading--family);font-size:40px;font-weight:900;letter-spacing:.04em;display:block;margin:6px 0}
  #ol-{{ section.id }} .ol-code .ol-btn{background:var(--ink);color:var(--av);margin-top:16px;padding:14px 26px;font-size:16px}
  #ol-{{ section.id }} .ol-sec{padding:64px 0 0}
  #ol-{{ section.id }} .ol-sec>h2{font-size:clamp(32px,4.5vw,52px);font-weight:800;line-height:1.05;margin-bottom:24px}
  #ol-{{ section.id }} .ol-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px}
  #ol-{{ section.id }} .ol-card{background:#fff;border-radius:24px;padding:28px}
  #ol-{{ section.id }} .ol-card.ol-cel{background:var(--cel)}
  #ol-{{ section.id }} .ol-price{display:flex;align-items:baseline;gap:10px;margin:0 0 10px;font-family:var(--font-heading--family)}
  #ol-{{ section.id }} .ol-price s{font-size:20px;color:var(--mid);opacity:.75}
  #ol-{{ section.id }} .ol-price b{font-size:28px;font-weight:900}
  #ol-{{ section.id }} .ol-cap{margin:6px auto 0;font-size:14px;color:#CBC4BC}
  #ol-{{ section.id }} .ol-card .ol-d{font-size:26px;font-weight:900;line-height:1.1;margin-bottom:10px}
  #ol-{{ section.id }} .ol-card p{margin:0;font-size:16px;line-height:1.55;color:var(--mid)}
  #ol-{{ section.id }} .ol-trust{display:flex;flex-wrap:wrap;gap:10px;margin-top:20px}
  #ol-{{ section.id }} .ol-trust span{background:var(--ecru);border-radius:999px;padding:12px 20px;font-weight:700;font-size:15px}
  #ol-{{ section.id }} details{background:#fff;border-radius:20px;padding:20px 24px;margin-bottom:10px}
  #ol-{{ section.id }} summary{font-weight:800;font-size:18px;cursor:pointer}
  #ol-{{ section.id }} details .ol-a{margin:12px 0 0;line-height:1.6;color:var(--mid)}
  #ol-{{ section.id }} details .ol-a p{margin:0}
  #ol-{{ section.id }} .ol-end{text-align:center;background:var(--cel);border-radius:32px;padding:56px 24px;margin:64px 0 40px}
  #ol-{{ section.id }} .ol-end h2{font-size:clamp(32px,4.5vw,52px);font-weight:900;line-height:1.05}
  #ol-{{ section.id }} .ol-end .ol-lead{font-size:18px;margin:14px auto 0;max-width:620px;line-height:1.5;color:var(--mid)}
  #ol-{{ section.id }} .ol-end .ol-lead p{margin:0}
  #ol-{{ section.id }} .ol-end input[type=email]{background:#fff}
  #ol-{{ section.id }} .ol-end button{background:var(--ink);color:var(--av)}
  #ol-{{ section.id }} .ol-end .ol-small{color:var(--mid)}
  #ol-{{ section.id }} .ol-end .ol-err{color:#8C1D18}
  #ol-{{ section.id }} .ol-checks{display:flex;flex-direction:column;gap:8px;margin:16px auto 0;max-width:520px;text-align:left}
  #ol-{{ section.id }} .ol-check{display:flex;gap:10px;align-items:flex-start;font-size:14px;line-height:1.45;color:#E4DED6;cursor:pointer}
  #ol-{{ section.id }} .ol-check input{flex:0 0 auto;width:18px;height:18px;margin:1px 0 0;accent-color:var(--cel);cursor:pointer}
  #ol-{{ section.id }} .ol-check a{color:inherit;text-decoration:underline}
  #ol-{{ section.id }} .ol-end .ol-check{color:var(--ink)}
  #ol-{{ section.id }} .ol-end .ol-check input{accent-color:var(--ink)}
</style>

{%- capture consent_fields -%}
  <div class="ol-checks">
    <label class="ol-check"><input type="checkbox" name="contact[accepts_marketing]" value="true"{% if section.settings.marketing_required %} required{% endif %}><span>{{ section.settings.marketing_label }}</span></label>
    <label class="ol-check"><input type="checkbox" name="contact[privacy]" value="si" required><span>{{ section.settings.privacy_label }} <a href="{{ section.settings.privacy_url }}" target="_blank" rel="noopener">l'informativa privacy</a>.</span></label>
  </div>
{%- endcapture -%}

{%- capture signup_success -%}
  <div class="ol-code" data-ol-success>
    {{ section.settings.success_intro }}<b>{{ section.settings.code }}</b>{{ section.settings.success_text }}
    <br><a class="ol-btn" href="{{ redirect_url }}">{{ section.settings.success_button }}</a>
  </div>
{%- endcapture -%}

<div id="ol-{{ section.id }}" class="ol">
  <section class="ol-hero">
    <h1>{{ section.settings.heading }} <span>{{ section.settings.heading_accent }}</span></h1>
    {%- if section.settings.intro != blank -%}<div class="ol-lead">{{ section.settings.intro }}</div>{%- endif -%}

    {%- if n_layers > 0 -%}
      <div class="ol-mat" role="img" aria-label="Il materasso Concomodo che si apre e mostra i suoi strati">
        {%- comment -%} Chiuso = solo rivestimento (sopra + base), gli strati interni dentro; aperto = strati separati come nella scheda prodotto {%- endcomment -%}
        {%- assign closed = '221,184.4,62.6,-64.9,-153.9' | split: ',' -%}
        {%- assign scales = '1,0.35,0.35,0.35,1' | split: ',' -%}
        {%- assign alphas = '1,0,0,0,1' | split: ',' -%}
        {%- assign tops = '0,20.41,36.53,50.92,77.14' | split: ',' -%}
        {%- assign zs = '10,8,7,6,9' | split: ',' -%}
        {%- assign dels = '0,0.12,0.08,0.04,0' | split: ',' -%}
        {%- for i in (1..5) -%}
          {%- assign key = 'layer_' | append: i -%}
          {%- assign idx = forloop.index0 -%}
          {%- if section.settings[key] != blank -%}
            {%- assign top_style = 'top:' | append: tops[idx] | append: '%' -%}
            <div class="ol-ly" style="--c:{{ closed[idx] }}%;--s:{{ scales[idx] }};--a:{{ alphas[idx] }};--d:{{ dels[idx] }}s;z-index:{{ zs[idx] }}">
              {{ section.settings[key] | image_url: width: 1200 | image_tag: alt: '', loading: 'eager', style: top_style, widths: '600,900,1200', sizes: '(min-width: 700px) 600px, 92vw' }}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.mat_caption != blank -%}<div class="ol-cap">{{ section.settings.mat_caption }}</div>{%- endif -%}

    {%- form 'customer', id: 'ol-form-top' -%}
      {%- if form.posted_successfully? -%}
        <div style="margin-top:24px">{{ signup_success }}</div>
      {%- else -%}
        <input type="hidden" name="contact[tags]" value="{{ section.settings.tags }}">
        <div class="ol-row">
          <input type="email" name="contact[email]" placeholder="La tua email" required aria-label="La tua email" autocomplete="email">
          <button type="submit">{{ section.settings.button }}</button>
        </div>
        {{ consent_fields }}
        {%- if form.errors -%}<div class="ol-err">Controlla l'indirizzo email e riprova.</div>{%- endif -%}
        <div class="ol-small">{{ section.settings.privacy_top }}</div>
      {%- endif -%}
    {%- endform -%}
  </section>

  <section class="ol-sec">
    <h2>{{ section.settings.offers_heading }}</h2>
    <div class="ol-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'offerta' -%}
          <div class="ol-card{% if block.settings.highlight %} ol-cel{% endif %}" {{ block.shopify_attributes }}>
            <div class="ol-d">{{ block.settings.title }}</div>
            {%- if block.settings.price_new != blank -%}
              <div class="ol-price">{% if block.settings.price_old != blank %}<s>{{ block.settings.price_old }}</s> {% endif %}<b>{{ block.settings.price_new }}</b></div>
            {%- endif -%}
            <p>{{ block.settings.text }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- assign chips = section.settings.trust | split: '|' -%}
    {%- if chips.size > 0 -%}
      <div class="ol-trust">{%- for c in chips -%}<span>{{ c | strip }}</span>{%- endfor -%}</div>
    {%- endif -%}
  </section>

  <section class="ol-sec">
    <h2>{{ section.settings.faq_heading }}</h2>
    {%- for block in section.blocks -%}
      {%- if block.type == 'faq' -%}
        <details {{ block.shopify_attributes }}><summary>{{ block.settings.question }}</summary><div class="ol-a">{{ block.settings.answer }}</div></details>
      {%- endif -%}
    {%- endfor -%}
  </section>

  <section class="ol-end">
    <h2>{{ section.settings.end_heading }}</h2>
    {%- if section.settings.end_text != blank -%}<div class="ol-lead">{{ section.settings.end_text }}</div>{%- endif -%}
    {%- form 'customer', id: 'ol-form-end' -%}
      {%- if form.posted_successfully? -%}
        {{ signup_success }}
      {%- else -%}
        <input type="hidden" name="contact[tags]" value="{{ section.settings.tags }}">
        <div class="ol-row">
          <input type="email" name="contact[email]" placeholder="La tua email" required aria-label="La tua email" autocomplete="email">
          <button type="submit">{{ section.settings.button }}</button>
        </div>
        {{ consent_fields }}
        {%- if form.errors -%}<div class="ol-err">Controlla l'indirizzo email e riprova.</div>{%- endif -%}
        <div class="ol-small">{{ section.settings.privacy_end }}</div>
      {%- endif -%}
    {%- endform -%}
  </section>
</div>

<script>
  (function () {
    var root = document.getElementById('ol-{{ section.id }}');
    if (!root) return;
    var ok = root.querySelector('[data-ol-success]');
    if (!ok || window.Shopify && window.Shopify.designMode) return;
    ok.scrollIntoView({ block: 'center' });
    setTimeout(function () { location.href = {{ redirect_url | json }}; }, {{ section.settings.redirect_seconds | times: 1000 }});
  })();
</script>

{% schema %}
{
  "name": "Offerte di lancio",
  "tag": "div",
  "class": "section-offerte-lancio",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Offerte di lancio" },
    { "type": "text", "id": "heading_accent", "label": "Titolo, seconda riga (celeste)", "default": "già attive." },
    { "type": "richtext", "id": "intro", "label": "Testo", "default": "<p>Il sito è appena nato e per festeggiare abbiamo preparato qualche regalo. I prezzi restano quelli di sempre, tutto l'anno: in più, per tutto il periodo di lancio, trovi i vantaggi qui sotto.</p>" },
    { "type": "image_picker", "id": "layer_1", "label": "Strato 1 (in alto)" },
    { "type": "image_picker", "id": "layer_2", "label": "Strato 2" },
    { "type": "image_picker", "id": "layer_3", "label": "Strato 3" },
    { "type": "image_picker", "id": "layer_4", "label": "Strato 4" },
    { "type": "image_picker", "id": "layer_5", "label": "Strato 5 (base)" },
    { "type": "text", "id": "mat_caption", "label": "Didascalia sotto il materasso" },
    { "type": "header", "content": "Iscrizione" },
    { "type": "text", "id": "button", "label": "Testo bottone", "default": "Accedi alle offerte" },
    { "type": "text", "id": "tags", "label": "Tag cliente", "default": "newsletter,lancio-2026" },
    { "type": "text", "id": "privacy_top", "label": "Nota privacy (hero)", "default": "Iscrivendoti ricevi il codice di benvenuto e le nostre email, puoi cancellarti quando vuoi." },
    { "type": "text", "id": "privacy_end", "label": "Nota privacy (chiusa)", "default": "Puoi cancellarti quando vuoi." },
    { "type": "text", "id": "privacy_url", "label": "Link informativa privacy", "default": "/policies/privacy-policy" },
    { "type": "text", "id": "marketing_label", "label": "Checkbox marketing", "default": "Voglio ricevere via email il codice di benvenuto, le offerte e le novità di Concomodo." },
    { "type": "checkbox", "id": "marketing_required", "label": "Checkbox marketing obbligatoria", "default": true },
    { "type": "text", "id": "privacy_label", "label": "Checkbox privacy (prima del link)", "default": "Ho letto e accetto" },
    { "type": "text", "id": "code", "label": "Codice sconto", "default": "DI20COMODO" },
    { "type": "text", "id": "success_intro", "label": "Dopo l'iscrizione: prima del codice", "default": "Ecco il tuo codice di benvenuto" },
    { "type": "text", "id": "success_text", "label": "Dopo l'iscrizione: dopo il codice", "default": "Inseriscilo al checkout: 20 € in meno sul primo ordine. Tra pochi secondi ti portiamo sul sito." },
    { "type": "text", "id": "success_button", "label": "Dopo l'iscrizione: bottone", "default": "Vai al sito ora" },
    { "type": "url", "id": "redirect_url", "label": "Pagina dopo l'iscrizione (vuoto = home)" },
    { "type": "range", "id": "redirect_seconds", "label": "Secondi prima del rimando", "min": 3, "max": 15, "step": 1, "unit": "s", "default": 6 },
    { "type": "header", "content": "Offerte e domande" },
    { "type": "text", "id": "offers_heading", "label": "Titolo offerte", "default": "Cosa trovi per il lancio" },
    { "type": "text", "id": "trust", "label": "Garanzie (separate da |)", "default": "100 notti di prova | 10 anni di garanzia | 100% Made in Italy | Dal produttore a casa tua" },
    { "type": "text", "id": "faq_heading", "label": "Titolo domande", "default": "Domande frequenti" },
    { "type": "header", "content": "Chiusa" },
    { "type": "text", "id": "end_heading", "label": "Titolo", "default": "Da stanotte, dormi Concomodo." },
    { "type": "richtext", "id": "end_text", "label": "Testo", "default": "<p>Lasciaci la tua email: ricevi subito 20 € di benvenuto e accedi alle offerte di lancio.</p>" }
  ],
  "blocks": [
    {
      "type": "offerta",
      "name": "Offerta",
      "settings": [
        { "type": "text", "id": "title", "label": "Titolo", "default": "Cuscino in regalo con il topper" },
        { "type": "textarea", "id": "text", "label": "Testo" },
        { "type": "checkbox", "id": "highlight", "label": "Evidenzia (sfondo celeste)", "default": false },
        { "type": "text", "id": "price_old", "label": "Prezzo barrato (facoltativo)" },
        { "type": "text", "id": "price_new", "label": "Prezzo in offerta (facoltativo)" }
      ]
    },
    {
      "type": "faq",
      "name": "Domanda",
      "settings": [
        { "type": "text", "id": "question", "label": "Domanda" },
        { "type": "richtext", "id": "answer", "label": "Risposta" }
      ]
    }
  ],
  "presets": [{ "name": "Offerte di lancio" }]
}
{% endschema %}
