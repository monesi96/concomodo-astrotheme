<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} made-italy color-{{ section.settings.color_scheme }} spacing-style{% if section.settings.image_position == 'left' %} made-italy--media-left{% endif %}"
  style="{% render 'spacing-style', settings: section.settings %} --mi-radius: {{ section.settings.corner_radius }}px;"
  {% if request.visual_preview_mode %}data-shopify-visual-preview{% endif %}
>
  {%- if section.settings.show_flag -%}
    <span class="made-italy__flag" aria-hidden="true"><i></i><i></i><i></i></span>
  {%- endif -%}
  <div class="made-italy__inner">
    <div class="made-italy__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="made-italy__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="made-italy__text">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a href="{{ section.settings.button_link }}" class="made-italy__button button">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>

    <div class="made-italy__media">
      {%- if section.blocks.size > 0 -%}
        <made-italy-autoplay
          class="made-italy__carousel{% if section.blocks.size == 1 %} is-single{% endif %}"
          data-autoplay="{{ section.settings.autoplay }}"
          data-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
        >
          <div class="made-italy__viewport" role="region" aria-label="{{ section.settings.heading | strip_html | escape }}">
            <div class="made-italy__track">
              {%- for block in section.blocks -%}
                <figure class="made-italy__slide" {{ block.shopify_attributes }}>
                  {%- if block.settings.image != blank -%}
                    {%- liquid
                      assign img_loading = 'lazy'
                      if forloop.first and section.index < 3
                        assign img_loading = 'eager'
                      endif
                    -%}
                    {{
                      block.settings.image
                      | image_url: width: 1600
                      | image_tag:
                        loading: img_loading,
                        widths: '600, 900, 1200, 1600',
                        sizes: '(min-width: 990px) 50vw, 90vw',
                        class: 'made-italy__img',
                        draggable: 'false'
                    }}
                  {%- else -%}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'made-italy__img made-italy__img--placeholder' }}
                  {%- endif -%}
                  {%- if block.settings.caption != blank -%}
                    <figcaption class="made-italy__caption">{{ block.settings.caption }}</figcaption>
                  {%- endif -%}
                </figure>
              {%- endfor -%}
            </div>
          </div>
        </made-italy-autoplay>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  if (!customElements.get('made-italy-autoplay')) {
    customElements.define(
      'made-italy-autoplay',
      class extends HTMLElement {
        connectedCallback() {
          this.track = this.querySelector('.made-italy__track');
          if (!this.track) return;
          this.slides = Array.from(this.track.children);
          this.count = this.slides.length;
          if (this.count < 2) return;

          // Copie delle card in coda: servono per il giro continuo senza salti all'indietro.
          this.slides.forEach((slide) => {
            const clone = slide.cloneNode(true);
            clone.setAttribute('aria-hidden', 'true');
            clone.removeAttribute('data-shopify-editor-block');
            clone.classList.add('is-clone');
            clone.querySelectorAll('img').forEach((img) => (img.loading = 'eager'));
            this.track.appendChild(clone);
          });

          this.index = 0;

          this.onTransitionEnd = (event) => {
            if (event.target === this.track && this.index >= this.count) this.jump(0);
          };
          this.track.addEventListener('transitionend', this.onTransitionEnd);

          this.onResize = () => this.jump(this.index % this.count);
          window.addEventListener('resize', this.onResize);

          this.onVisibility = () => (document.hidden ? this.pause() : this.inView && this.play());
          document.addEventListener('visibilitychange', this.onVisibility);

          const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (this.dataset.autoplay === 'true' && !reduce) {
            this.observer = new IntersectionObserver(
              (entries) => {
                entries.forEach((entry) => {
                  this.inView = entry.isIntersecting;
                  this.inView ? this.play() : this.pause();
                });
              },
              { threshold: 0.3 }
            );
            this.observer.observe(this);
          }
        }

        disconnectedCallback() {
          this.pause();
          if (this.observer) this.observer.disconnect();
          if (this.onResize) window.removeEventListener('resize', this.onResize);
          if (this.onVisibility) document.removeEventListener('visibilitychange', this.onVisibility);
        }

        step() {
          const gap = parseFloat(getComputedStyle(this.track).columnGap) || 0;
          return this.slides[0].getBoundingClientRect().width + gap;
        }

        apply() {
          this.track.style.transform = 'translate3d(' + -this.index * this.step() + 'px, 0, 0)';
        }

        jump(i) {
          this.track.classList.add('is-jumping');
          this.index = i;
          this.apply();
          void this.track.offsetWidth;
          this.track.classList.remove('is-jumping');
        }

        next() {
          if (this.index >= this.count) this.jump(0);
          this.index += 1;
          this.apply();
        }

        play() {
          if (this.timer) return;
          this.timer = setInterval(() => this.next(), Number(this.dataset.speed) || 5000);
        }

        pause() {
          clearInterval(this.timer);
          this.timer = null;
        }
      }
    );
  }
</script>

{% stylesheet %}
  .made-italy {
    --mi-radius: 24px;
  }

  .made-italy__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.75rem, 4vw, 4rem);
    align-items: center;
    max-width: 1200px;
    margin-inline: auto;
  }

  @media screen and (min-width: 990px) {
    .made-italy__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }

    .made-italy--media-left .made-italy__content {
      order: 2;
    }
  }

  .made-italy__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .made-italy__flag {
    display: flex;
    gap: 6px;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto clamp(1.5rem, 3vw, 2.5rem);
  }

  .made-italy__flag i {
    display: block;
    flex: 1;
    height: 6px;
    border-radius: 3px;
  }

  .made-italy__flag i:nth-child(1) { background: #009246; }
  .made-italy__flag i:nth-child(2) { background: rgb(var(--color-foreground-rgb) / 0.15); }
  .made-italy__flag i:nth-child(3) { background: #ce2b37; }

  .made-italy__heading {
    margin: 0;
    text-wrap: balance;
  }

  .made-italy__text {
    line-height: 1.6;
    opacity: 0.85;
    max-width: 52ch;
  }

  .made-italy__text > :first-child { margin-block-start: 0; }
  .made-italy__text > :last-child { margin-block-end: 0; }

  .made-italy__button {
    margin-block-start: 0.5rem;
  }

  .made-italy__media {
    min-width: 0;
  }

  .made-italy__carousel {
    --mi-gap: 16px;
    --mi-card: 86%;
    display: block;
    position: relative;
  }

  .made-italy__carousel.is-single {
    --mi-card: 100%;
  }

  /* Nessuno scorrimento manuale: niente scroll, swipe, trascinamento o tastiera */
  .made-italy__viewport {
    overflow: hidden;
    overflow: clip;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }

  .made-italy__track {
    display: flex;
    gap: var(--mi-gap);
    will-change: transform;
    transition: transform 0.9s cubic-bezier(0.45, 0, 0.2, 1);
  }

  .made-italy__track.is-jumping {
    transition: none;
  }

  .made-italy__slide {
    position: relative;
    flex: 0 0 var(--mi-card);
    margin: 0;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--mi-radius);
    background: rgb(var(--color-foreground-rgb) / 0.06);
  }

  .made-italy__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    -webkit-user-drag: none;
  }

  .made-italy__img--placeholder {
    background: rgb(var(--color-foreground-rgb) / 0.06);
  }

  .made-italy__caption {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    background: var(--color-background);
    color: var(--color-foreground);
    font-size: 0.85rem;
    line-height: 1.3;
  }

  @media screen and (max-width: 749px) {
    .made-italy__carousel {
      --mi-gap: 12px;
      --mi-card: 88%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .made-italy__track {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Fatti in Italia",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_flag",
      "label": "Mostra linea tricolore",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titolo",
      "default": "I nostri materassi li facciamo noi, in Italia."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Testo",
      "default": "<p>Tagliamo le schiume su misura, cuciamo i rivestimenti nel nostro reparto e controlliamo ogni materasso prima di imballarlo. Da qui parte direttamente verso casa tua, dal produttore a te senza intermediari.</p><p>Seguire tutto da vicino ci permette di curare ogni dettaglio e di tenere un prezzo onesto.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Testo pulsante"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link pulsante"
    },
    {
      "type": "header",
      "content": "Carosello"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Posizione foto su desktop",
      "options": [
        { "value": "right", "label": "Destra" },
        { "value": "left", "label": "Sinistra" }
      ],
      "default": "right"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Scorrimento automatico",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Secondi per foto",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Raggio angoli",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Sezione"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Larghezza sezione",
      "options": [
        { "value": "page-width", "label": "Pagina" },
        { "value": "full-width", "label": "Piena" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Schema colore",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spaziatura"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Sopra",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Sotto",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Sinistra",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Destra",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Foto",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Immagine"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Didascalia (facoltativa)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fatti in Italia",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
