{%- liquid
  assign product_a = product
  assign spec_a = product_a.metafields.custom.comparison.value
  assign compare_with = product_a.metafields.custom.compare_with.value

  comment
    Materassi selezionabili: la collezione scelta nelle impostazioni,
    altrimenti la prima collezione del prodotto in pagina.
  endcomment
  assign source = section.settings.compare_collection
  if source == blank
    assign source = product_a.collections.first
  endif

  comment
    Un posto in più nel limite: il prodotto in pagina fa parte della sua
    collezione e viene scartato dall'elenco dei candidati.
  endcomment
  assign fetch_limit = section.settings.max_products | plus: 1

  comment
    Primo giro: conta i candidati e decide quale mostrare all'apertura.
    Preferiamo il materasso di `custom.compare_with` se è nella collezione,
    così le pagine già configurate continuano a partire dallo stesso confronto.
  endcomment
  assign candidate_count = 0
  assign first_handle = ''
  assign compare_with_available = false
  for candidate in source.products limit: fetch_limit
    if candidate.id == product_a.id
      continue
    endif
    assign candidate_count = candidate_count | plus: 1
    if first_handle == ''
      assign first_handle = candidate.handle
    endif
    if compare_with != blank and candidate.id == compare_with.id
      assign compare_with_available = true
    endif
  endfor

  comment
    Collezione senza altri materassi: si ricade sul singolo prodotto del
    metafield, cioè il comportamento statico di prima, senza selettore.
  endcomment
  assign use_single = false
  if candidate_count == 0 and compare_with != blank
    assign use_single = true
  endif

  assign selected_handle = first_handle
  if compare_with_available or use_single
    assign selected_handle = compare_with.handle
  endif

  comment
    URL iniziale della CTA quando non è stato impostato un link fisso.
  endcomment
  assign selected_url = ''
  if use_single
    assign selected_url = compare_with.url
  else
    for candidate in source.products limit: fetch_limit
      if candidate.handle == selected_handle
        assign selected_url = candidate.url
        break
      endif
    endfor
  endif

  comment
    Il prodotto in pagina deve avere i propri dati di confronto: senza,
    la sezione resta nascosta invece di mostrare due colonne vuote.
  endcomment
  assign has_data = false
  if spec_a != blank and selected_handle != ''
    assign has_data = true
  endif

  comment
    Con un solo materasso confrontabile il selettore non serve.
  endcomment
  assign show_picker = false
  if use_single == false and candidate_count > 1
    assign show_picker = true
  endif
-%}

{%- if has_data -%}
  <script
    src="{{ 'mattress-comparison.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>

  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <mattress-comparison-component
    class="section section--{{ section.settings.section_width }} mattress-comparison color-{{ section.settings.color_scheme }} spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
    {% if request.visual_preview_mode %}data-shopify-visual-preview{% endif %}
  >
    {%- if section.settings.heading != blank -%}
      <h2 class="mattress-comparison__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- comment -%}
      Il selettore sta fuori dalla card, sopra le due colonne: dentro la barra
      sticky prendeva il posto del titolo del secondo materasso e non era
      chiaro cosa comandasse.
    {%- endcomment -%}
    {%- if show_picker -%}
      <div class="mattress-comparison__picker">
        {%- if section.settings.picker_label != blank -%}
          <label class="mattress-comparison__picker-label" for="mc-picker-{{ section.id }}">
            {{- section.settings.picker_label -}}
          </label>
        {%- endif -%}
        <div class="mattress-comparison__picker-field">
          <select
            id="mc-picker-{{ section.id }}"
            class="mattress-comparison__picker-select"
            ref="picker"
            on:change="/handleSelect"
            {% if section.settings.picker_label == blank %}
              aria-label="{{ 'Confronta con' | escape }}"
            {% endif %}
          >
            {%- for candidate in source.products limit: fetch_limit -%}
              {%- if candidate.id == product_a.id -%}
                {%- continue -%}
              {%- endif -%}
              <option
                value="{{ candidate.handle }}"
                {% if candidate.handle == selected_handle %}
                  selected
                {% endif %}
              >
                {{- candidate.title | strip_html | escape -}}
              </option>
            {%- endfor -%}
          </select>
          <svg
            class="mattress-comparison__picker-chevron"
            viewBox="0 0 12 8"
            fill="none"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M1 1.5 6 6.5 11 1.5"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </div>
      </div>
    {%- endif -%}

    <div class="mattress-comparison__card">
      <div class="mattress-comparison__divider" aria-hidden="true"></div>
      <div class="mattress-comparison__grid">
        {%- comment -%} ── Product images (scroll away) ── {%- endcomment -%}
        {%- liquid
          assign head_img_a = spec_a.card_image | default: product_a.featured_image
        -%}
        <a href="{{ product_a.url }}" class="mattress-comparison__head-media">
          {%- if spec_a.badge != blank -%}
            <span class="mattress-comparison__badge">{{ spec_a.badge }}</span>
          {%- endif -%}
          {% render 'image', image: head_img_a, class: 'mattress-comparison__head-image' %}
        </a>
        {% render 'comparison-slot',
          row: 'media',
          products: source.products,
          exclude: product_a,
          max_items: fetch_limit,
          selected: selected_handle,
          use_single: use_single,
          single_product: compare_with
        %}

        {%- comment -%} ── Product info (sticky bar: title + desc + price) ── {%- endcomment -%}
        <div class="mattress-comparison__info-row" ref="stickyBar">
          {%- liquid
            assign head_desc_a = spec_a.short_description | default: product_a.description

            assign min_price_a = 0
            for v in product_a.variants
              if v.price > 0 and min_price_a == 0
                assign min_price_a = v.price
              elsif v.price > 0 and v.price < min_price_a
                assign min_price_a = v.price
              endif
            endfor
          -%}
          <div class="mattress-comparison__info">
            <a href="{{ product_a.url }}" class="mattress-comparison__head-title">{{ product_a.title }}</a>
            {%- if head_desc_a != blank -%}
              <div class="mattress-comparison__head-desc">{{ head_desc_a | strip_html | truncatewords: 22 }}</div>
            {%- endif -%}
            {%- if min_price_a > 0 -%}
              <div class="mattress-comparison__head-price">{{ min_price_a | money }}</div>
            {%- endif -%}
          </div>

          <div class="mattress-comparison__info">
            {% render 'comparison-slot',
              row: 'info',
              products: source.products,
              exclude: product_a,
              max_items: fetch_limit,
              selected: selected_handle,
              use_single: use_single,
              single_product: compare_with,
              show_title: true
            %}
          </div>
        </div>

        {%- comment -%} ── Row: Sensazione (scale + title/description) ── {%- endcomment -%}
        {%- if section.settings.show_feel -%}
          {% render 'comparison-tooltip', label: section.settings.feel_label, tooltip: section.settings.feel_tooltip %}
          {% render 'comparison-cell',
            type: 'feel',
            spec: spec_a,
            min_label: section.settings.firmness_min_label,
            max_label: section.settings.firmness_max_label
          %}
          {% render 'comparison-slot',
            row: 'feel',
            products: source.products,
            exclude: product_a,
            max_items: fetch_limit,
            selected: selected_handle,
            use_single: use_single,
            single_product: compare_with,
            min_label: section.settings.firmness_min_label,
            max_label: section.settings.firmness_max_label
          %}
        {%- endif -%}

        {%- comment -%} ── Row: Supporto ergonomico (meter a tacche) ── {%- endcomment -%}
        {%- if section.settings.show_support -%}
          {% render 'comparison-tooltip', label: section.settings.support_label, tooltip: section.settings.support_tooltip %}
          {% render 'comparison-cell',
            type: 'meter',
            title: spec_a.support_title,
            value: spec_a.support_value,
            min_label: section.settings.support_min_label,
            max_label: section.settings.support_max_label
          %}
          {% render 'comparison-slot',
            row: 'support',
            products: source.products,
            exclude: product_a,
            max_items: fetch_limit,
            selected: selected_handle,
            use_single: use_single,
            single_product: compare_with,
            min_label: section.settings.support_min_label,
            max_label: section.settings.support_max_label
          %}
        {%- endif -%}

        {%- comment -%} ── Row: Raffreddamento e traspirabilità (meter a tacche) ── {%- endcomment -%}
        {%- if section.settings.show_cooling -%}
          {% render 'comparison-tooltip', label: section.settings.cooling_label, tooltip: section.settings.cooling_tooltip %}
          {% render 'comparison-cell',
            type: 'meter',
            title: spec_a.cooling_title,
            value: spec_a.cooling_value,
            min_label: section.settings.cooling_min_label,
            max_label: section.settings.cooling_max_label
          %}
          {% render 'comparison-slot',
            row: 'cooling',
            products: source.products,
            exclude: product_a,
            max_items: fetch_limit,
            selected: selected_handle,
            use_single: use_single,
            single_product: compare_with,
            min_label: section.settings.cooling_min_label,
            max_label: section.settings.cooling_max_label
          %}
        {%- endif -%}

        {%- comment -%} ── Row: Altezza del materasso ── {%- endcomment -%}
        {%- if section.settings.show_height -%}
          {% render 'comparison-tooltip', label: section.settings.height_label, tooltip: section.settings.height_tooltip %}
          {% render 'comparison-cell', type: 'value', value: spec_a.height_value, subtext: spec_a.height_subtext %}
          {% render 'comparison-slot',
            row: 'height',
            products: source.products,
            exclude: product_a,
            max_items: fetch_limit,
            selected: selected_handle,
            use_single: use_single,
            single_product: compare_with
          %}
        {%- endif -%}

        {%- comment -%} ── Row: Strati del materasso ── {%- endcomment -%}
        {%- if section.settings.show_layers -%}
          {% render 'comparison-tooltip', label: section.settings.layers_label, tooltip: section.settings.layers_tooltip %}
          {% render 'comparison-cell', type: 'value', value: spec_a.layers_count, subtext: spec_a.layers_subtext %}
          {% render 'comparison-slot',
            row: 'layers',
            products: source.products,
            exclude: product_a,
            max_items: fetch_limit,
            selected: selected_handle,
            use_single: use_single,
            single_product: compare_with
          %}
        {%- endif -%}

        {%- comment -%} ── CTA: segue il materasso selezionato ── {%- endcomment -%}
        {%- if section.settings.cta_label != blank -%}
          <div class="mattress-comparison__footer">
            <a
              class="mattress-comparison__cta button"
              {% if section.settings.cta_link != blank %}
                href="{{ section.settings.cta_link }}"
              {% else %}
                href="{{ selected_url }}"
                ref="cta"
              {% endif %}
            >
              {{ section.settings.cta_label }}
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </mattress-comparison-component>

{%- elsif request.design_mode -%}
  <div class="section section--page-width color-{{ section.settings.color_scheme }} spacing-style">
    <div class="mattress-comparison__placeholder">
      <p>To display the comparison, this product needs:</p>
      <ul>
        <li>
          a <code>custom.comparison</code> metaobject on this product —
          {% if spec_a != blank %}✓ set{% else %}✗ missing{% endif %}
        </li>
        <li>
          at least one other mattress to compare with —
          {% if candidate_count > 0 %}
            ✓ {{ candidate_count }} in “{{ source.title }}”
          {% elsif use_single %}
            ✓ 1 from <code>custom.compare_with</code>
          {% else %}
            ✗ pick a collection in the section settings, or set <code>custom.compare_with</code>
          {% endif %}
        </li>
      </ul>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .mattress-comparison {
    --cmp-muted: rgb(var(--color-foreground-rgb) / 0.06);
    --cmp-line: rgb(var(--color-foreground-rgb) / 0.12);

    /* Bump every text ~30%: root base + em-based child sizes */
    font-size: 1.3rem;
  }

  /* Mobile: testo ridotto del 30% (i figli sono in em, scalano con il root) */
  @media screen and (max-width: 749px) {
    .mattress-comparison {
      font-size: 0.91rem;
    }
  }

  .mattress-comparison__heading {
    margin: 0 0 5rem;
    text-align: center;
  }

  /* Col selettore in mezzo, titolo e campo devono leggersi come un blocco solo */
  .mattress-comparison__heading:has(+ .mattress-comparison__picker) {
    margin-block-end: 1.5rem;
  }

  .mattress-comparison__card {
    position: relative;
    max-width: 1000px;
    margin: 0 auto;
    background: #fff;
    border: 1px solid var(--cmp-line);
    border-radius: 20px;
    padding: clamp(1rem, 3vw, 2.5rem);
    box-shadow: 0 20px 50px rgb(var(--color-foreground-rgb) / 0.05);
  }

  /* Vertical divider between the two columns */
  .mattress-comparison__divider {
    position: absolute;
    inset-block: clamp(1rem, 3vw, 2.5rem);
    inset-inline-start: 50%;
    width: 1px;
    background: var(--cmp-line);
    transform: translateX(-50%);
    pointer-events: none;
  }

  .mattress-comparison__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: clamp(1.5rem, 6vw, 4.5rem);
    row-gap: 1.5rem;
    align-items: start;
  }

  /* ── Product headers ── */
  .mattress-comparison__head-media {
    position: relative;
    display: block;
    width: 100%;
    border-radius: 14px;
    overflow: hidden;
  }

  /* Sticky bar: full-width white background + soft bottom shadow */
  .mattress-comparison__info-row {
    grid-column: 1 / -1;
    position: sticky;
    top: calc(var(--header-height, 0px) - 0.1rem);
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: clamp(1.5rem, 6vw, 4.5rem);
    background: #fff;
    box-shadow: 0 12px 14px -8px rgb(var(--color-foreground-rgb) / 0);
    transition: box-shadow 0.25s ease;
  }

  /* Shadow only once the bar is pinned to the top */
  .mattress-comparison__info-row.is-stuck {
    box-shadow: 0 12px 14px -8px rgb(var(--color-foreground-rgb) / 0.18);
  }

  .mattress-comparison__info {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding-block: 1rem;
    text-align: center;
  }

  .mattress-comparison__head-price {
    font-weight: 700;
    font-size: 1.1em;
    margin-block-start: 0.25rem;
  }

  .mattress-comparison__head-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .mattress-comparison__badge {
    position: absolute;
    inset-block-start: 0.75rem;
    inset-inline-start: 0.75rem;
    padding: 0.35em 0.85em;
    border-radius: 999px;
    background: var(--color-background);
    font-size: 0.8em;
    font-weight: 600;
    box-shadow: 0 2px 8px rgb(var(--color-foreground-rgb) / 0.15);
  }

  .mattress-comparison__head-title {
    font-size: clamp(1.25em, 2.5vw, 1.75em);
    font-weight: 700;
    text-decoration: none;
    color: inherit;
  }

  .mattress-comparison__head-desc {
    font-size: 0.9em;
    opacity: 0.7;
    max-width: 32ch;
  }

  /* ── Colonna selezionabile ──
     Ogni materasso candidato è già nel DOM: il cambio di selezione mostra il
     pannello giusto e nasconde gli altri, quindi il confronto è immediato. */
  .mattress-comparison__info .mattress-comparison__slot,
  .mattress-comparison__info .mattress-comparison__pane {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
  }

  /* Deve battere il display:flex qui sopra, non solo lo stile di default di [hidden] */
  .mattress-comparison__pane[hidden] {
    display: none;
  }

  /* Selettore sopra le colonne: etichetta e campo su una riga centrata */
  .mattress-comparison__picker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 0.75rem;
    max-width: 100%;
    margin: 0 auto 2.5rem;
  }

  .mattress-comparison__picker-label {
    font-size: 0.95em;
    font-weight: 600;
    opacity: 0.7;
  }

  /* La dimensione vive qui così il chevron scala insieme al testo */
  .mattress-comparison__picker-field {
    position: relative;
    display: flex;
    align-items: center;
    max-width: 100%;
    font-size: 1em;
  }

  .mattress-comparison__picker-select {
    appearance: none;
    max-width: 100%;
    margin: 0;
    padding: 0.65em 2.6em 0.65em 1.2em;
    border: 1px solid var(--cmp-line);
    border-radius: 999px;
    background: var(--color-background);
    color: inherit;
    font: inherit;
    font-weight: 600;
    line-height: 1.3;
    text-overflow: ellipsis;
    cursor: pointer;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .mattress-comparison__picker-select:hover {
    border-color: rgb(var(--color-foreground-rgb) / 0.35);
    background: var(--cmp-muted);
  }

  .mattress-comparison__picker-select:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 2px;
  }

  .mattress-comparison__picker-chevron {
    position: absolute;
    inset-inline-end: 1.2em;
    width: 0.7em;
    height: auto;
    opacity: 0.55;
    pointer-events: none;
  }

  /* Dato mancante: la riga resta allineata invece di collassare */
  .mattress-comparison__empty {
    font-size: 1.6em;
    line-height: 1.6;
    opacity: 0.3;
  }

  /* ── Row header pill (spans both columns) ── */
  .mattress-comparison__row-header {
    grid-column: 1 / -1;
    display: flex;
    justify-content: center;
    margin-block: 0.75rem;
    /* Ancora la bolla del tooltip: centrata sulla riga, mai oltre il viewport */
    position: relative;
  }

  .mattress-comparison__pill {
    display: inline-flex;
    align-items: flex-start;
    justify-content: center;
    gap: 0.5rem;
    width: min(100%, 640px);
    padding: 0.6em 1.25em;
    border-radius: 999px;
    background: #cbc4bc;
    font-weight: 400;
    font-size: 1.2em;
    text-align: center;
  }

  /* ── Tooltip ── */
  /* Non posizionato: la bolla si ancora al row-header, non al bottone, così con
     etichette lunghe non finisce fuori dallo schermo allargando il documento. */
  .mattress-comparison__tip {
    display: inline-flex;
  }

  .mattress-comparison__tip-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5em;
    height: 1.5em;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(var(--color-foreground-rgb) / 0.55);
    color: var(--color-background);
    font-size: 0.5em;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
  }

  .mattress-comparison__tip-btn:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 2px;
  }

  .mattress-comparison__tip-bubble {
    position: absolute;
    inset-block-start: calc(100% + 8px);
    inset-inline-start: 50%;
    z-index: 5;
    width: max-content;
    max-width: min(260px, calc(100% - 2rem));
    padding: 0.75rem 1rem;
    border-radius: 12px;
    background: rgb(var(--color-foreground-rgb) / 0.92);
    color: var(--color-background);
    font-size: 0.6em;
    font-weight: 400;
    line-height: 1.4;
    text-align: start;
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, -6px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
    box-shadow: 0 10px 30px rgb(var(--color-foreground-rgb) / 0.25);
  }

  .mattress-comparison__tip.is-open .mattress-comparison__tip-bubble {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }

  /* ── Value cells ── */
  .mattress-comparison__cell {
    text-align: center;
    padding-block: 0.5rem 1.25rem;
  }

  .mattress-comparison__value-title {
    font-weight: 600;
    margin-block-end: 0.35rem;
  }

  .mattress-comparison__value-text {
    font-size: 0.9em;
    line-height: 1.5;
    opacity: 0.75;
    max-width: 34ch;
    margin-inline: auto;
  }

  .mattress-comparison__value-big {
    font-size: clamp(2em, 4vw, 2.75em);
    font-weight: 700;
    line-height: 1.1;
  }

  .mattress-comparison__value-sub {
    font-size: 0.9em;
    opacity: 0.7;
    margin-block-start: 0.25rem;
  }

  /* ── Firmness scale ── */
  .mattress-comparison__scale-label {
    font-weight: 600;
    margin-block-end: 0.6rem;
  }

  .mattress-comparison__scale {
    position: relative;
    height: 6px;
    margin-inline: auto;
    max-width: 240px;
    border-radius: 999px;
    background: rgb(var(--color-foreground-rgb) / 0.12);
  }

  .mattress-comparison__scale-fill {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: clamp(0%, calc(var(--v, 50) * 1%), 100%);
    border-radius: 999px;
    background: rgb(var(--color-foreground-rgb) / 0.55);
  }

  .mattress-comparison__scale-knob {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: clamp(0%, calc(var(--v, 50) * 1%), 100%);
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--color-foreground);
    transform: translate(-50%, -50%);
    box-shadow: 0 2px 6px rgb(var(--color-foreground-rgb) / 0.3);
  }

  .mattress-comparison__scale-ends {
    display: flex;
    justify-content: space-between;
    max-width: 240px;
    margin: 0.5rem auto 0;
    font-size: 0.8em;
    opacity: 0.6;
  }

  .mattress-comparison__scale + .mattress-comparison__value-title,
  .mattress-comparison__scale-ends + .mattress-comparison__value-title {
    margin-block-start: 1rem;
  }

  /* ── Level meter (support & cooling): 5 tacche a riempimento proporzionale ── */
  .mattress-comparison__meter {
    display: flex;
    gap: 5px;
    max-width: 240px;
    margin-inline: auto;
  }

  .mattress-comparison__meter-seg {
    position: relative;
    flex: 1;
    height: 8px;
    border-radius: 999px;
    background: rgb(var(--color-foreground-rgb) / 0.12);
    overflow: hidden;
  }

  .mattress-comparison__meter-seg::before {
    content: '';
    position: absolute;
    inset: 0;
    width: var(--f, 0%);
    border-radius: inherit;
    background: rgb(var(--color-foreground-rgb) / 0.55);
  }

  /* ── Footer / CTA ── */
  .mattress-comparison__footer {
    grid-column: 2;
    display: flex;
    justify-content: center;
    margin-block-start: 1.5rem;
  }

  .mattress-comparison__placeholder {
    padding: 2rem;
    border: 1px dashed var(--cmp-line, rgb(var(--color-foreground-rgb) / 0.3));
    border-radius: 12px;
  }

  .mattress-comparison__placeholder ul {
    margin-block: 0.5rem 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .mattress-comparison__tip-bubble {
      transition: none;
    }
  }

  /* ── Solo schermi stretti: stesso design, meno costrizione.
     Le colonne da ~135px su 360px schiacciavano titoli e CTA. ── */
  @media screen and (max-width: 749px) {
    .mattress-comparison__heading {
      margin-block-end: 2rem;
    }

    /* gap identico su griglia e barra sticky, altrimenti si disallineano */
    .mattress-comparison__grid,
    .mattress-comparison__info-row {
      column-gap: 0.625rem;
    }

    .mattress-comparison__head-title {
      font-size: 1.05em;
    }

    /* la descrizione da 22 parole rendeva la barra sticky alta ~220px */
    .mattress-comparison__head-desc {
      display: none;
    }

    .mattress-comparison__picker {
      margin-block-end: 1.5rem;
    }

    .mattress-comparison__pill {
      font-size: 1em;
      padding: 0.5em 0.9em;
    }

    .mattress-comparison__footer {
      grid-column: 1 / -1;
    }

    .mattress-comparison__cta {
      width: 100%;
    }
  }
{% endstylesheet %}

