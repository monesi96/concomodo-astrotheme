{%- comment -%}
  Hero atmosfera (v3) — testo a sinistra, foto a destra a filo dei bordi
  e, sotto la foto, una fascia di cielo animato: il ciclo
  giorno → tramonto → sera → notte gira in loop (10 s di default),
  graduale e uguale per tutti. Le nuvole entrano da sinistra e restano
  visibili solo dentro la fascia. Tutto in CSS, nessuna libreria.
{%- endcomment -%}

{{ 'hero-atmosfera.css' | asset_url | stylesheet_tag }}

{%- liquid
  case section.settings.height
    when 'piccola'
      assign height = '62svh'
    when 'grande'
      assign height = '88svh'
    when 'schermo'
      assign height = '100svh'
    else
      assign height = '76svh'
  endcase

  assign photo_frac = section.settings.photo_height | divided_by: 100.0
-%}

<div
  id="hero-atm-{{ section.id }}"
  class="hero-atm"
  style="
    --ha-height: {{ height }};
    --ha-photo: {{ photo_frac }};
    --ha-cycle: {{ section.settings.cycle_seconds }}s;
  "
  {% if request.visual_preview_mode %}
    data-shopify-visual-preview
  {% endif %}
>
  <div class="hero-atm__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="hero-atm__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="hero-atm__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="hero-atm__text">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.settings.button_label != blank or section.settings.button_2_label != blank -%}
      <div class="hero-atm__actions">
        {%- if section.settings.button_label != blank -%}
          <a
            class="hero-atm__button button"
            {% if section.settings.button_link != blank %}
              href="{{ section.settings.button_link }}"
            {% endif %}
          >
            {{- section.settings.button_label -}}
          </a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a
            class="hero-atm__button button hero-atm__button--ghost"
            {% if section.settings.button_2_link != blank %}
              href="{{ section.settings.button_2_link }}"
            {% endif %}
          >
            {{- section.settings.button_2_label -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="hero-atm__visual">
    <div class="hero-atm__photo">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1800
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '600, 900, 1200, 1500, 1800',
            sizes: '(min-width: 750px) 50vw, 100vw',
            alt: section.settings.image.alt
        }}
      {%- else -%}
        {{ 'hero-apparel-2' | placeholder_svg_tag: 'hero-atm__placeholder' }}
      {%- endif -%}
    </div>

    <div class="hero-atm__sky" aria-hidden="true">
      <div class="hero-atm__layer hero-atm__layer--tramonto"></div>
      <div class="hero-atm__layer hero-atm__layer--sera"></div>
      <div class="hero-atm__layer hero-atm__layer--notte"></div>

      {%- if section.settings.show_stars -%}
        <div class="hero-atm__stars">
          {%- for i in (1..40) -%}
            {%- liquid
              # posizioni pseudo-casuali ma stabili: dipendono solo dall'indice
              assign x = i | times: 37 | modulo: 96 | plus: 2
              assign y = i | times: 61 | modulo: 62 | plus: 4
              assign s = i | modulo: 3 | plus: 1
              assign d = i | times: 137 | modulo: 4000
              assign t = i | modulo: 4 | plus: 3
            -%}
            <span
              class="hero-atm__star"
              style="--x: {{ x }}%; --y: {{ y }}%; --s: {{ s }}px; --d: -{{ d }}ms; --t: {{ t }}s;"
            ></span>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="hero-atm__sun"></div>
      <div class="hero-atm__moon"></div>

      {%- if section.settings.cloud_count > 0 -%}
        <div class="hero-atm__clouds">
          {%- for i in (1..section.settings.cloud_count) -%}
            {%- liquid
              assign top = i | times: 17 | modulo: 52 | plus: 6
              assign w = i | times: 53 | modulo: 150 | plus: 130
              assign speed = i | times: 29 | modulo: 40 | plus: 42
              assign delay = i | times: 37 | modulo: 80
              assign o = i | modulo: 4 | times: 14 | plus: 40
              assign sx = i | times: 23 | modulo: 70 | plus: 10
            -%}
            <span
              class="hero-atm__cloud"
              style="--top: {{ top }}%; --w: {{ w }}px; --speed: {{ speed }}s; --delay: -{{ delay }}s; --o: 0.{{ o }}; --sx: 0.{{ sx }};"
            ></span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero atmosfera",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "height",
      "label": "Altezza",
      "options": [
        { "value": "piccola", "label": "Compatta" },
        { "value": "media", "label": "Media" },
        { "value": "grande", "label": "Grande" },
        { "value": "schermo", "label": "Tutto lo schermo" }
      ],
      "default": "media"
    },
    {
      "type": "header",
      "content": "Testo"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Occhiello"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titolo",
      "default": "La tua nuova routine sarà <strong>dormire bene</strong>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Testo",
      "default": "<p>Materassi pensati per il riposo vero: prova 100 notti, reso gratuito, garanzia 10 anni.</p>"
    },
    {
      "type": "header",
      "content": "Pulsanti"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Pulsante principale",
      "default": "Scopri Con comodo"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link del pulsante principale"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Pulsante secondario",
      "default": "Fai il quiz"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Link del pulsante secondario"
    },
    {
      "type": "header",
      "content": "Foto"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Immagine",
      "info": "Riempie la parte alta della colonna destra, a filo dei bordi e senza tagli ai lati. Finché è vuota si vede un segnaposto."
    },
    {
      "type": "range",
      "id": "photo_height",
      "label": "Altezza della foto",
      "info": "Quanta colonna destra occupa la foto: il resto è il cielo animato.",
      "min": 45,
      "max": 75,
      "step": 1,
      "unit": "%",
      "default": 62
    },
    {
      "type": "header",
      "content": "Cielo animato"
    },
    {
      "type": "range",
      "id": "cycle_seconds",
      "label": "Durata del ciclo giorno–notte",
      "info": "Giorno, tramonto, sera e notte si alternano in loop, in modo graduale.",
      "min": 6,
      "max": 24,
      "step": 1,
      "unit": "s",
      "default": 10
    },
    {
      "type": "range",
      "id": "cloud_count",
      "label": "Numero di nuvole",
      "min": 0,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "Mostra le stelle di notte",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Hero atmosfera"
    }
  ]
}
{% endschema %}
