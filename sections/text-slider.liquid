{%- comment -%}
  Slider testuale — strip a scorrimento continuo con le promesse del brand.
  Ogni voce è un blocco: può usare il colore di base, il colore accento o un
  colore personalizzato. Con "colori alternati" le voci si alternano da sole.
  Ogni voce può avere un'icona (set integrato o immagine caricata).
{%- endcomment -%}

<script src="{{ 'text-slider.js' | asset_url }}" defer></script>

{%- liquid
  assign accent = section.settings.accent_color
  assign items = section.blocks
-%}

{%- if items.size > 0 -%}
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <text-slider-strip
    class="section section--full-width text-slider color-{{ section.settings.color_scheme }} spacing-style{% if section.settings.pause_on_hover %} text-slider--pausable{% endif %}{% if section.settings.show_borders %} text-slider--bordered{% endif %}{% if section.settings.edge_fade %} text-slider--faded{% endif %}"
    style="
      {%- render 'spacing-style', settings: section.settings %}
      --ts-gap-base: {{ section.settings.gap }}px;
      --ts-size: {{ section.settings.text_size }}px;
      --ts-weight: {{ section.settings.font_weight }};
      --ts-accent: {{ accent }};
      --ts-fade: {{ section.settings.edge_fade_width }}%;
      --ts-direction: {% if section.settings.direction == 'right' %}reverse{% else %}normal{% endif %};
    "
    data-speed="{{ section.settings.speed }}"
    {% if request.visual_preview_mode %}
      data-shopify-visual-preview
    {% endif %}
  >
    <div class="text-slider__viewport">
      <div class="text-slider__track" data-ts-track>
        <div class="text-slider__group" data-ts-group>
          {%- for block in items -%}
            {%- liquid
              assign color_value = ''
              assign is_odd_item = forloop.index0 | modulo: 2
              case block.settings.color_mode
                when 'accent'
                  assign color_value = accent
                when 'custom'
                  assign color_value = block.settings.custom_color
                when 'auto'
                  if section.settings.alternate_colors and is_odd_item == 0
                    assign color_value = accent
                  endif
              endcase
            -%}
            {%- capture ts_icon -%}
              {%- case block.settings.icon -%}
                {%- when 'moon' -%}
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M19.5 14.6A7.8 7.8 0 0 1 9.4 4.5a7.8 7.8 0 1 0 10.1 10.1Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M16 4.5h2.5L16 7.5h2.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {%- when 'shield' -%}
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 3 5 5.5v6c0 4.2 2.9 7.6 7 9 4.1-1.4 7-4.8 7-9v-6L12 3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="m8.8 11.8 2.3 2.3 4.2-4.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {%- when 'truck' -%}
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2.5 6h11v10h-11z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M13.5 9h4l3 3.5V16h-7" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="6.5" cy="17.5" r="1.9" fill="var(--color-background, #fff)" stroke="currentColor" stroke-width="1.6"/><circle cx="16.5" cy="17.5" r="1.9" fill="var(--color-background, #fff)" stroke="currentColor" stroke-width="1.6"/></svg>
                {%- when 'card' -%}
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="5.5" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M3 10h18M7 14.5h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                {%- when 'flag' -%}
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M5.5 21V3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M5.5 4.5h12l-2.5 4 2.5 4h-12" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
                {%- when 'return' -%}
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 5 4.5 9.5 9 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M4.5 9.5H15a4.5 4.5 0 0 1 0 9H8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {%- when 'check' -%}
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.6"/><path d="m8.5 12.2 2.4 2.4 4.6-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {%- when 'star' -%}
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="m12 3.5 2.6 5.4 5.9.8-4.3 4.1 1 5.8L12 16.8l-5.2 2.8 1-5.8-4.3-4.1 5.9-.8L12 3.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
              {%- endcase -%}
            {%- endcapture -%}
            <span
              class="text-slider__item{% if section.settings.uppercase %} text-slider__item--upper{% endif %}"
              {% if color_value != blank %}
                style="--ts-item-color: {{ color_value }};"
              {% endif %}
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.icon_image != blank -%}
                <span class="text-slider__icon" aria-hidden="true">
                  {{- block.settings.icon_image | image_url: width: 96 | image_tag: alt: '', loading: 'lazy' -}}
                </span>
              {%- elsif ts_icon != blank -%}
                <span class="text-slider__icon" aria-hidden="true">{{- ts_icon -}}</span>
              {%- endif -%}
              {%- if block.settings.link != blank -%}
                <a class="text-slider__link" href="{{ block.settings.link }}">{{ block.settings.text }}</a>
              {%- else -%}
                {{ block.settings.text }}
              {%- endif -%}
            </span>
            {%- unless section.settings.separator == 'none' -%}
              <span class="text-slider__separator" aria-hidden="true">
                {%- case section.settings.separator -%}
                  {%- when 'dot' -%}•
                  {%- when 'slash' -%}/
                  {%- when 'star' -%}✳
                  {%- when 'line' -%}
                    <span class="text-slider__rule"></span>
                  {%- when 'custom' -%}
                    {{- section.settings.separator_text -}}
                {%- endcase -%}
              </span>
            {%- endunless -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </text-slider-strip>

{%- elsif request.design_mode -%}
  <div class="section section--page-width color-{{ section.settings.color_scheme }} spacing-style">
    <p class="text-slider__placeholder">Aggiungi una o più voci di testo per popolare lo slider.</p>
  </div>
{%- endif -%}

{% stylesheet %}
  .text-slider {
    --ts-gap: var(--ts-gap-base, 48px);
    --ts-size: 20px;
    --ts-weight: 500;

    display: block;
    width: 100%;
    overflow: hidden;
  }

  .text-slider--bordered {
    border-block: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
  }

  .text-slider__viewport {
    overflow: hidden;
  }

  .text-slider--faded .text-slider__viewport {
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 var(--ts-fade, 10%), #000 calc(100% - var(--ts-fade, 10%)), transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, #000 var(--ts-fade, 10%), #000 calc(100% - var(--ts-fade, 10%)), transparent 100%);
  }

  .text-slider__track {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  .text-slider--ready .text-slider__track {
    animation: text-slider-scroll var(--ts-duration, 30s) linear infinite;
    animation-direction: var(--ts-direction, normal);
  }

  .text-slider--pausable:hover .text-slider__track,
  .text-slider--pausable:focus-within .text-slider__track {
    animation-play-state: paused;
  }

  @keyframes text-slider-scroll {
    to {
      transform: translate3d(calc(-1 * var(--ts-distance, 50%)), 0, 0);
    }
  }

  .text-slider__group {
    display: flex;
    align-items: center;
    gap: var(--ts-gap);
    padding-inline-end: var(--ts-gap);
    min-width: max-content;
  }

  .text-slider__item {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    color: var(--ts-item-color, var(--color-foreground));
    font-family: var(--font-body--family);
    font-size: var(--ts-size);
    font-weight: var(--ts-weight);
    line-height: 1.2;
    white-space: nowrap;
  }

  .text-slider__icon {
    display: inline-flex;
    flex-shrink: 0;
    width: 1.25em;
    height: 1.25em;
  }

  .text-slider__icon svg,
  .text-slider__icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .text-slider__item--upper {
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .text-slider__link {
    color: inherit;
    text-decoration: none;
  }

  .text-slider__link:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .text-slider__separator {
    color: rgb(var(--color-foreground-rgb) / 0.35);
    font-size: calc(var(--ts-size) * 0.8);
    line-height: 1;
    display: flex;
    align-items: center;
  }

  .text-slider__rule {
    display: block;
    width: calc(var(--ts-gap) * 0.8);
    height: 1px;
    background: currentcolor;
  }

  .text-slider__placeholder {
    padding: 1.5rem;
    border: 1px dashed rgb(var(--color-foreground-rgb) / 0.3);
    border-radius: 12px;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .text-slider {
      --ts-gap: max(20px, calc(var(--ts-gap-base, 48px) * 0.65));
    }

    .text-slider__item {
      font-size: calc(var(--ts-size) * 0.8);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .text-slider__track {
      animation: none !important;
    }

    .text-slider__viewport {
      overflow-x: auto;
      scrollbar-width: thin;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Slider testuale",
  "tag": "section",
  "blocks": [
    {
      "type": "item",
      "name": "Voce",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Testo",
          "default": "Prova 100 notti"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icona",
          "options": [
            { "value": "none", "label": "Nessuna" },
            { "value": "moon", "label": "Luna (notti di prova)" },
            { "value": "shield", "label": "Scudo (garanzia)" },
            { "value": "truck", "label": "Furgone (spedizione)" },
            { "value": "card", "label": "Carta (pagamento)" },
            { "value": "flag", "label": "Bandiera (Made in Italy)" },
            { "value": "return", "label": "Reso" },
            { "value": "check", "label": "Spunta" },
            { "value": "star", "label": "Stella" }
          ],
          "default": "none"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icona personalizzata (sostituisce quella sopra)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (facoltativo)"
        },
        {
          "type": "select",
          "id": "color_mode",
          "label": "Colore",
          "options": [
            { "value": "auto", "label": "Automatico (alternato)" },
            { "value": "base", "label": "Colore testo" },
            { "value": "accent", "label": "Colore accento" },
            { "value": "custom", "label": "Personalizzato" }
          ],
          "default": "auto"
        },
        {
          "type": "color",
          "id": "custom_color",
          "label": "Colore personalizzato",
          "default": "#464646"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "Velocità",
      "info": "Pixel al secondo: più alto, più veloce.",
      "min": 10,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direzione",
      "options": [
        { "value": "left", "label": "Verso sinistra" },
        { "value": "right", "label": "Verso destra" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Metti in pausa al passaggio del mouse",
      "default": true
    },
    {
      "type": "header",
      "content": "Testo"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Dimensione testo",
      "min": 12,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Spessore",
      "options": [
        { "value": "400", "label": "Normale" },
        { "value": "500", "label": "Medio" },
        { "value": "600", "label": "Semi-grassetto" },
        { "value": "700", "label": "Grassetto" }
      ],
      "default": "500"
    },
    {
      "type": "checkbox",
      "id": "uppercase",
      "label": "Tutto maiuscolo",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "alternate_colors",
      "label": "Colori alternati",
      "info": "Vale per le voci con colore \"Automatico\": una sì e una no usano il colore accento.",
      "default": true
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Colore accento",
      "info": "Tono brand con contrasto sufficiente per il testo. L'azzurro chiaro #b2c8d1 è poco leggibile su fondo crema.",
      "default": "#4a6f7d"
    },
    {
      "type": "header",
      "content": "Separatore"
    },
    {
      "type": "select",
      "id": "separator",
      "label": "Separatore tra le voci",
      "options": [
        { "value": "none", "label": "Nessuno" },
        { "value": "dot", "label": "Punto •" },
        { "value": "slash", "label": "Barra /" },
        { "value": "star", "label": "Asterisco ✳" },
        { "value": "line", "label": "Linea" },
        { "value": "custom", "label": "Personalizzato" }
      ],
      "default": "none"
    },
    {
      "type": "text",
      "id": "separator_text",
      "label": "Separatore personalizzato",
      "default": "—"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Spazio tra le voci",
      "min": 8,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Sezione"
    },
    {
      "type": "checkbox",
      "id": "show_borders",
      "label": "Linee sopra e sotto",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "edge_fade",
      "label": "Sfumatura ai lati",
      "info": "Il testo entra e esce in dissolvenza ai bordi.",
      "default": false
    },
    {
      "type": "range",
      "id": "edge_fade_width",
      "label": "Larghezza sfumatura",
      "min": 2,
      "max": 30,
      "step": 1,
      "unit": "%",
      "default": 10
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Schema colore",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Spaziatura"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Sopra",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Sotto",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Sinistra",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Destra",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Slider testuale",
      "blocks": {
        "item-1": { "type": "item", "settings": { "text": "Prova 100 notti", "icon": "moon", "color_mode": "auto" } },
        "item-2": { "type": "item", "settings": { "text": "Garanzia 10 anni", "icon": "shield", "color_mode": "auto" } },
        "item-3": { "type": "item", "settings": { "text": "Spedizione e reso gratuiti", "icon": "truck", "color_mode": "auto" } },
        "item-4": { "type": "item", "settings": { "text": "Pagamento in 3 rate", "icon": "card", "color_mode": "auto" } },
        "item-5": { "type": "item", "settings": { "text": "Made in Italy", "icon": "flag", "color_mode": "auto" } }
      },
      "block_order": ["item-1", "item-2", "item-3", "item-4", "item-5"]
    }
  ]
}
{% endschema %}
