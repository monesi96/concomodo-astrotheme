    },
    {
      "type": "text",
      "id": "price_text",
      "label": "Testo prezzo manuale",
      "info": "Se compilato, sostituisce il prezzo calcolato dalla collezione. Es: «a partire da 390€»"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Link bottone principale",
      "info": "Se vuoto: /collections/all"
    },
    {
      "type": "text",
      "id": "quiz_label",
      "label": "Testo bottone quiz",
      "default": "Non sai quale? Fai il quiz"
    },
    {
      "type": "url",
      "id": "quiz_url",
      "label": "Link bottone quiz",
      "info": "Se vuoto: /pages/quiz"
    }
  ],
  "presets": [
    {
      "name": "Perché dormire comodi V2"
    }
  ]
}
{% endschema %}
