    {
      "type": "header",
      "content": "Stato vuoto"
    },
    {
      "type": "text",
      "id": "empty_title",
      "label": "Titolo",
      "default": "Nessun materasso con questi filtri"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Testo",
      "default": "Prova ad allargare la ricerca, oppure azzera i filtri."
    },
    {
      "type": "header",
      "content": "Stile"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-2"
    },
    {
