{%- comment -%}
  Perché Concomodo — riquadro con etichetta (verticale a sinistra o orizzontale in cima)
  e card fotografiche a scorrimento orizzontale.
  Etichetta, pillole e testi delle card sono blocchi Testo: si formattano come qualsiasi testo del tema.
{%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} whycc whycc--label-{{ section.settings.label_layout }} color-{{ section.settings.color_scheme }} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %} --whycc-radius: {{ section.settings.corner_radius }}px; --whycc-bg: {{ section.settings.panel_color }}; --whycc-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --whycc-gap: {{ section.settings.label_gap }}px;"
>
  <div class="whycc__panel">
    {%- liquid
      if section.settings.label_layout == 'horizontal'
        assign label_align = section.settings.label_align_h
      else
        assign label_align = section.settings.label_align_v
      endif
      assign label_rgb = section.settings.label_color.red | append: ' ' | append: section.settings.label_color.green | append: ' ' | append: section.settings.label_color.blue
    -%}
    <div
      class="whycc__label whycc__label--{{ label_align }}"
      style="--color-foreground: {{ section.settings.label_color }}; --color-foreground-heading: {{ section.settings.label_color }}; --color-foreground-rgb: {{ label_rgb }}; color: {{ section.settings.label_color }};"
    >
      {%- content_for 'block', type: 'text', id: 'whycc-label' -%}
    </div>

    <div class="whycc__track" role="region" tabindex="0" aria-label="Perché Concomodo">
      <div class="whycc__rail" role="list">
        {%- content_for 'blocks' -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .whycc {
    --whycc-radius: 24px;
    --whycc-bg: #B2C8D1;
    --whycc-overlay: 0.25;
    --whycc-gap: 20px;
  }

  .whycc__panel {
    display: flex;
    align-items: stretch;
    gap: var(--whycc-gap);
    width: 100%;
    max-width: none;
    margin-inline: auto;
    padding: 20px;
    box-sizing: border-box;
    border-radius: var(--whycc-radius);
    background: var(--whycc-bg);
    overflow: hidden;
  }

  .whycc__label {
    display: flex;
    flex: 0 0 auto;
    min-width: 0;
  }

  .whycc__label:empty {
    display: none;
  }

  /* Etichetta verticale a sinistra (si legge dal basso verso l'alto, come nella reference) */
  .whycc--label-vertical .whycc__label {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    contain: inline-size;
    white-space: nowrap;
  }

  .whycc--label-vertical .whycc__label--start {
    justify-content: flex-end;
  }

  .whycc--label-vertical .whycc__label--center {
    justify-content: center;
  }

  .whycc--label-vertical .whycc__label--end {
    justify-content: flex-start;
  }

  .whycc--label-vertical .whycc__label .text-block,
  .whycc--label-vertical .whycc__label .text-block > * {
    width: auto;
    max-inline-size: none;
  }

  .whycc--label-vertical .whycc__label .text-block {
    block-size: 1lh;
  }

  /* Etichetta orizzontale in cima */
  .whycc--label-horizontal .whycc__panel {
    flex-direction: column;
  }

  .whycc--label-horizontal .whycc__label--left {
    justify-content: flex-start;
  }

  .whycc--label-horizontal .whycc__label--center {
    justify-content: center;
    text-align: center;
  }

  .whycc--label-horizontal .whycc__label--right {
    justify-content: flex-end;
    text-align: right;
  }

  .whycc__track {
    flex: 1 1 auto;
    min-width: 0;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(250px, 1fr);
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }

  .whycc__track::-webkit-scrollbar {
    display: none;
  }

  .whycc__track:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .whycc__card {
    position: relative;
    display: flex;
    flex-direction: column;
    aspect-ratio: 3 / 4;
    padding: 18px;
    box-sizing: border-box;
    border-radius: calc(var(--whycc-radius) * 0.7);
    clip-path: inset(0 round calc(var(--whycc-radius) * 0.7));
    width: 100%;
    align-self: stretch;
    isolation: isolate;
    scroll-snap-align: start;
    text-decoration: none;
    background: #8a8a8a;
  }

  .whycc__img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .whycc__img--placeholder {
    background: #9fb3bb;
    fill: rgb(255 255 255 / 0.35);
  }

  a.whycc__card:hover .whycc__img {
    transform: scale(1.04);
  }

  .whycc__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(0 0 0 / var(--whycc-overlay));
    pointer-events: none;
  }

  .whycc__card--bottom .whycc__shade {
    background: linear-gradient(to top, rgb(0 0 0 / calc(var(--whycc-overlay) * 2)) 0%, rgb(0 0 0 / calc(var(--whycc-overlay) * 0.5)) 60%);
  }

  .whycc__tag {
    align-self: flex-start;
    max-width: 100%;
    padding: 5px 12px;
    border: 1px solid currentColor;
    border-radius: 999px;
  }

  .whycc__tag--plain {
    padding: 0;
    border: 0;
    border-radius: 0;
  }

  .whycc__tag:empty,
  .whycc__text:empty {
    display: none;
  }

  .whycc__text {
    width: 100%;
  }

  .whycc__card--top .whycc__text {
    margin-top: 16px;
  }

  .whycc__card--center .whycc__text {
    margin-block: auto;
  }

  .whycc__card--bottom .whycc__text {
    margin-top: auto;
  }

  @media screen and (max-width: 749px) {
    .whycc__panel {
      gap: min(var(--whycc-gap), 16px);
      padding: 18px 0 18px 18px;
      border-radius: calc(var(--whycc-radius) * 0.8);
    }

    .whycc--label-horizontal .whycc__label {
      padding-inline-end: 18px;
    }

    .whycc__track {
      grid-auto-columns: 74vw;
      gap: 12px;
      padding-inline-end: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whycc__img {
      transition: none;
    }

    a.whycc__card:hover .whycc__img {
      transform: none;
    }
  }

  /* Scorrimento card: niente scroll verticale, taglio con angoli arrotondati come le card */
  .whycc__track {
    overflow-y: hidden;
    border-radius: calc(var(--whycc-radius) * 0.7);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Perché Concomodo",
  "tag": "section",
  "blocks": [
    { "type": "_whycc-card" }
  ],
  "settings": [
    {
      "type": "paragraph",
      "content": "Testo e formattazione dell'etichetta si modificano dal blocco Etichetta. Testi e pillole delle card dai blocchi dentro ogni card."
    },
    {
      "type": "header",
      "content": "Etichetta"
    },
    {
      "type": "select",
      "id": "label_layout",
      "label": "Posizione",
      "options": [
        { "value": "vertical", "label": "In verticale a sinistra" },
        { "value": "horizontal", "label": "In orizzontale in cima" }
      ],
      "default": "vertical"
    },
    {
      "type": "select",
      "id": "label_align_v",
      "label": "Allineamento",
      "options": [
        { "value": "start", "label": "In alto" },
        { "value": "center", "label": "Al centro" },
        { "value": "end", "label": "In basso" }
      ],
      "default": "start",
      "visible_if": "{{ section.settings.label_layout == 'vertical' }}"
    },
    {
      "type": "select",
      "id": "label_align_h",
      "label": "Allineamento",
      "options": [
        { "value": "left", "label": "A sinistra" },
        { "value": "center", "label": "Al centro" },
        { "value": "right", "label": "A destra" }
      ],
      "default": "left",
      "visible_if": "{{ section.settings.label_layout == 'horizontal' }}"
    },
    {
      "type": "range",
      "id": "label_gap",
      "label": "Spazio tra etichetta e card",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Colore etichetta",
      "info": "Vale quando il colore del blocco Etichetta è Testo o Intestazione",
      "default": "#464646"
    },
    {
      "type": "header",
      "content": "Card"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Posizione testo",
      "options": [
        { "value": "top", "label": "In alto" },
        { "value": "center", "label": "Al centro" },
        { "value": "bottom", "label": "In basso" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Scurimento foto",
      "info": "Aumentalo se il testo bianco si legge poco",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 25
    },
    {
      "type": "header",
      "content": "Riquadro"
    },
    {
      "type": "color",
      "id": "panel_color",
      "label": "Colore riquadro",
      "default": "#B2C8D1"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Raggio angoli",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Sezione"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Larghezza sezione",
      "options": [
        { "value": "page-width", "label": "Pagina" },
        { "value": "full-width", "label": "Piena" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Schema colore",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spaziatura"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Sopra",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Sotto",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Sinistra",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Destra",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Perché Concomodo",
      "blocks": {
        "whycc-label": {
          "type": "text",
          "name": "Etichetta",
          "static": true,
          "settings": {
            "text": "<p>Perché Concomodo</p>",
            "type_preset": "custom",
            "font": "var(--font-heading--family)",
            "weight": "500",
            "font_size": "2rem",
            "line_height": "tight",
            "max_width": "none"
          }
        },
        "card_1": {
          "type": "_whycc-card",
          "blocks": {
            "tag": { "type": "text", "static": true, "settings": { "text": "<p>Prova 100 notti</p>", "type_preset": "custom", "weight": "500", "font_size": "0.75rem", "line_height": "tight", "max_width": "none" } },
            "body": { "type": "text", "static": true, "settings": { "text": "<p>100 notti per sentirlo tuo.<br/>Reso o sostituzione gratuita.</p>", "type_preset": "custom", "weight": "500", "font_size": "1.125rem", "line_height": "tight", "max_width": "none" } }
          }
        },
        "card_2": {
          "type": "_whycc-card",
          "blocks": {
            "tag": { "type": "text", "static": true, "settings": { "text": "<p>Spedizione gratuita</p>", "type_preset": "custom", "weight": "500", "font_size": "0.75rem", "line_height": "tight", "max_width": "none" } },
            "body": { "type": "text", "static": true, "settings": { "text": "<p>Spedizione gratuita in tutta Italia.<br/>Dal produttore a casa tua.</p>", "type_preset": "custom", "weight": "500", "font_size": "1.125rem", "line_height": "tight", "max_width": "none" } }
          }
        }
      },
      "block_order": ["card_1", "card_2"]
    }
  ]
}
{% endschema %}
