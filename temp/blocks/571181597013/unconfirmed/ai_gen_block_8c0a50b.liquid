{% doc %}
  @prompt
    copia la sezione newsletter in homepage
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% capture ai_form_class %}ai-home-newsletter-{{ ai_gen_id }}__form{% endcapture %}

{% style %}
  .ai-home-newsletter-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: clamp(28px, 5vw, 56px) 24px;
    color: #464646;
    background: #f4efe8;
    box-sizing: border-box;
  }
  .ai-home-newsletter-{{ ai_gen_id }}__inner { max-width: 720px; margin: 0 auto; text-align: center; }
  .ai-home-newsletter-{{ ai_gen_id }}__heading {
    margin: 0 0 12px;
    color: #464646;
    font-family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    font-size: clamp(26px, 4vw, 40px);
    line-height: 1.15;
  }
  .ai-home-newsletter-{{ ai_gen_id }}__description { max-width: 560px; margin: 0 auto 24px; font-size: 16px; line-height: 1.55; }
  .ai-home-newsletter-{{ ai_gen_id }}__form { display: flex; flex-wrap: wrap; gap: 10px; width: 100%; margin: 0 auto; text-align: left; }
  .ai-home-newsletter-{{ ai_gen_id }}__email {
    flex: 1 1 250px; min-width: 0; min-height: 52px; padding: 12px 16px;
    border: 1px solid #706b65; border-radius: {{ block.settings.corner_radius }}px;
    background: #fff; color: #464646; font: inherit; box-sizing: border-box;
  }
  .ai-home-newsletter-{{ ai_gen_id }}__email::placeholder { color: #595959; opacity: 1; }
  .ai-home-newsletter-{{ ai_gen_id }}__button {
    min-height: 52px; padding: 12px 24px; border: 1px solid #464646;
    border-radius: {{ block.settings.corner_radius }}px; background: #464646; color: #fff;
    font: inherit; font-weight: 600; cursor: pointer;
  }
  .ai-home-newsletter-{{ ai_gen_id }}__button:hover { background: #2f2f2f; }
  .ai-home-newsletter-{{ ai_gen_id }}__button:focus-visible,
  .ai-home-newsletter-{{ ai_gen_id }}__email:focus-visible,
  .ai-home-newsletter-{{ ai_gen_id }}__consent input:focus-visible { outline: 3px solid #000f9f; outline-offset: 3px; }
  .ai-home-newsletter-{{ ai_gen_id }}__consent { flex: 1 1 100%; display: flex; align-items: flex-start; gap: 9px; margin-top: 4px; font-size: 14px; line-height: 1.5; }
  .ai-home-newsletter-{{ ai_gen_id }}__consent input { width: 18px; height: 18px; flex: 0 0 18px; margin: 2px 0 0; accent-color: #464646; }
  .ai-home-newsletter-{{ ai_gen_id }}__consent a { color: #464646; text-decoration: underline; }
  .ai-home-newsletter-{{ ai_gen_id }}__status { flex: 1 1 100%; margin: 6px 0 0; font-size: 14px; }
  .ai-home-newsletter-{{ ai_gen_id }}__error { color: #8a1c12; }
  @media screen and (max-width: 600px) {
    .ai-home-newsletter-{{ ai_gen_id }} { padding-right: 18px; padding-left: 18px; }
    .ai-home-newsletter-{{ ai_gen_id }}__button { flex: 1 1 100%; }
  }
{% endstyle %}

<div class="ai-home-newsletter-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-home-newsletter-{{ ai_gen_id }}__inner">
    {% if block.settings.heading != blank %}<h2 class="ai-home-newsletter-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
    {% if block.settings.description != blank %}<div class="ai-home-newsletter-{{ ai_gen_id }}__description">{{ block.settings.description }}</div>{% endif %}
    {% form 'customer', class: ai_form_class %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="visually-hidden" for="ai-home-newsletter-email-{{ ai_gen_id }}">{{ block.settings.email_label | escape }}</label>
      <input id="ai-home-newsletter-email-{{ ai_gen_id }}" class="ai-home-newsletter-{{ ai_gen_id }}__email" type="email" name="contact[email]" value="{{ form.email | escape }}" placeholder="{{ block.settings.email_label | escape }}" autocomplete="email" autocorrect="off" autocapitalize="off" required aria-required="true" {% if form.errors %}aria-invalid="true" aria-describedby="ai-home-newsletter-error-{{ ai_gen_id }}"{% endif %} {% if form.posted_successfully? %}aria-describedby="ai-home-newsletter-success-{{ ai_gen_id }}"{% endif %}>
      <button class="ai-home-newsletter-{{ ai_gen_id }}__button" type="submit">{{ block.settings.button_label | escape }}</button>
      {% if settings.newsletter_consent_enabled %}
        <label class="ai-home-newsletter-{{ ai_gen_id }}__consent">
          <input type="checkbox" name="contact[consent_privacy]" value="yes" required aria-required="true">
          <span>{{ settings.newsletter_consent_text }}</span>
        </label>
      {% endif %}
      {% if form.errors %}<p id="ai-home-newsletter-error-{{ ai_gen_id }}" class="ai-home-newsletter-{{ ai_gen_id }}__status ai-home-newsletter-{{ ai_gen_id }}__error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{% endif %}
      {% if form.posted_successfully? %}<p id="ai-home-newsletter-success-{{ ai_gen_id }}" class="ai-home-newsletter-{{ ai_gen_id }}__status" role="status">{{ block.settings.success_message | escape }}</p>{% endif %}
    {% endform %}
  </div>
</div>

{% schema %}
{
  "name": "Newsletter homepage",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Iscriviti alla newsletter" },
    { "type": "richtext", "id": "description", "label": "Descrizione", "default": "<p>Ricevi novità, ispirazioni e aggiornamenti direttamente nella tua casella email.</p>" },
    { "type": "text", "id": "email_label", "label": "Testo campo email", "default": "Il tuo indirizzo email" },
    { "type": "text", "id": "button_label", "label": "Testo pulsante", "default": "Iscriviti" },
    { "type": "text", "id": "success_message", "label": "Messaggio di conferma", "default": "Grazie per esserti iscritto!" },
    { "type": "range", "id": "desktop_width_percent", "label": "Larghezza desktop", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "corner_radius", "label": "Raggio angoli", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 8 }
  ],
  "presets": [{ "name": "Newsletter homepage" }],
  "tag": null,
  "class": "homepage-newsletter-block"
}
{% endschema %}