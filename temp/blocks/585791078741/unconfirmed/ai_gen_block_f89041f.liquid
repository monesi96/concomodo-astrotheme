{% doc %}
  @prompt
    copia la sezione "iscrizione alla newsletter" così come compare nel modello homepage
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% capture ai_form_id %}NewsletterForm-{{ ai_gen_id }}{% endcapture %}

{% style %}
  .ai-newsletter-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-inline: auto;
    padding: 48px 24px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    text-align: center;
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
  }
  .ai-newsletter-{{ ai_gen_id }}__inner { width: 100%; max-width: 680px; margin: 0 auto; }
  .ai-newsletter-{{ ai_gen_id }}__heading {
    margin: 0 0 12px;
    color: {{ block.settings.text_color }};
    font-family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    font-size: clamp(28px, 4vw, 42px);
    line-height: 1.15;
    font-weight: 600;
  }
  .ai-newsletter-{{ ai_gen_id }}__description { margin: 0 auto 24px; max-width: 560px; font-size: 16px; line-height: 1.6; }
  .ai-newsletter-{{ ai_gen_id }}__description p { margin: 0; }
  .ai-newsletter-{{ ai_gen_id }}__form-row { display: flex; gap: 10px; max-width: 560px; margin: 0 auto; }
  .ai-newsletter-{{ ai_gen_id }}__input {
    min-width: 0; flex: 1 1 auto; min-height: 52px; padding: 12px 16px;
    border: 1px solid {{ block.settings.border_color }}; border-radius: {{ settings.inputs_border_radius }}px;
    background: #ffffff; color: #303030; font: inherit;
  }
  .ai-newsletter-{{ ai_gen_id }}__input::placeholder { color: #595959; opacity: 1; }
  .ai-newsletter-{{ ai_gen_id }}__button {
    min-height: 52px; padding: 12px 24px; border: 1px solid {{ block.settings.button_color }};
    border-radius: {{ settings.button_border_radius_primary }}px; background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }}; font: inherit; font-weight: 600; cursor: pointer;
  }
  .ai-newsletter-{{ ai_gen_id }}__button:hover { filter: brightness(0.92); }
  .ai-newsletter-{{ ai_gen_id }}__consent { display: flex; align-items: flex-start; justify-content: center; gap: 9px; max-width: 560px; margin: 16px auto 0; text-align: left; font-size: 13px; line-height: 1.5; }
  .ai-newsletter-{{ ai_gen_id }}__consent input { margin-top: 3px; flex: 0 0 auto; }
  .ai-newsletter-{{ ai_gen_id }}__consent a { color: inherit; text-decoration: underline; }
  .ai-newsletter-{{ ai_gen_id }}__message { margin: 16px 0 0; font-size: 14px; }
  .ai-newsletter-{{ ai_gen_id }}__error { color: #8a1f11; }
  .ai-newsletter-{{ ai_gen_id }} :focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  @media screen and (max-width: 600px) {
    .ai-newsletter-{{ ai_gen_id }} { padding: 36px 18px; }
    .ai-newsletter-{{ ai_gen_id }}__form-row { flex-direction: column; }
    .ai-newsletter-{{ ai_gen_id }}__button { width: 100%; }
  }
{% endstyle %}

<div class="ai-newsletter-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-newsletter-{{ ai_gen_id }}__inner">
    {% if block.settings.heading != blank %}<h2 class="ai-newsletter-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
    {% if block.settings.description != blank %}<div class="ai-newsletter-{{ ai_gen_id }}__description">{{ block.settings.description }}</div>{% endif %}
    {% form 'customer', id: ai_form_id %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="ai-newsletter-{{ ai_gen_id }}__form-row">
        <label class="visually-hidden" for="NewsletterEmail-{{ ai_gen_id }}">{{ block.settings.email_label | escape }}</label>
        <input id="NewsletterEmail-{{ ai_gen_id }}" class="ai-newsletter-{{ ai_gen_id }}__input" type="email" name="contact[email]" value="{{ form.email }}" placeholder="{{ block.settings.email_placeholder | escape }}" autocomplete="email" autocorrect="off" autocapitalize="off" required aria-required="true" {% if form.errors %}aria-invalid="true" aria-describedby="NewsletterError-{{ ai_gen_id }}"{% endif %}>
        <button class="ai-newsletter-{{ ai_gen_id }}__button" type="submit">{{ block.settings.button_label | escape }}</button>
      </div>
      {% if settings.newsletter_consent_enabled %}
        <label class="ai-newsletter-{{ ai_gen_id }}__consent">
          <input type="checkbox" name="contact[consent_privacy]" value="accepted" required aria-required="true">
          <span>{% if settings.newsletter_consent_text != blank %}{{ settings.newsletter_consent_text }}{% else %}Ho letto e accetto la <a href="/policies/privacy-policy" target="_blank" rel="noopener">privacy policy</a>.{% endif %}</span>
        </label>
      {% endif %}
      {% if form.errors %}<p id="NewsletterError-{{ ai_gen_id }}" class="ai-newsletter-{{ ai_gen_id }}__message ai-newsletter-{{ ai_gen_id }}__error" role="alert">{{ form.errors.messages.email }}</p>{% endif %}
      {% if form.posted_successfully? %}<p class="ai-newsletter-{{ ai_gen_id }}__message" role="status">{{ block.settings.success_message | escape }}</p>{% endif %}
    {% endform %}
  </div>
</div>

{% schema %}
{
  "name": "Iscrizione newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Resta in contatto con noi" },
    { "type": "richtext", "id": "description", "label": "Testo", "default": "<p>Iscriviti alla newsletter per ricevere novità e consigli per il tuo riposo.</p>" },
    { "type": "text", "id": "email_label", "label": "Etichetta email", "default": "Indirizzo email" },
    { "type": "text", "id": "email_placeholder", "label": "Segnaposto email", "default": "La tua email" },
    { "type": "text", "id": "button_label", "label": "Testo pulsante", "default": "Iscriviti" },
    { "type": "text", "id": "success_message", "label": "Messaggio di conferma", "default": "Grazie per esserti iscritto." },
    { "type": "range", "id": "desktop_width_percent", "label": "Larghezza desktop", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "background_color", "label": "Sfondo", "default": "#F4EFE8" },
    { "type": "color", "id": "text_color", "label": "Testo", "default": "#464646" },
    { "type": "color", "id": "border_color", "label": "Bordo campo", "default": "#CBC4BC" },
    { "type": "color", "id": "button_color", "label": "Sfondo pulsante", "default": "#464646" },
    { "type": "color", "id": "button_text_color", "label": "Testo pulsante", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "Iscrizione newsletter" }],
  "tag": null,
  "class": "newsletter-signup-block"
}
{% endschema %}