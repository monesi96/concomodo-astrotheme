<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    {% if settings.transition_to_main_product or settings.page_transition_enabled %}
      <link
        rel="expect"
        href="#MainContent"
        blocking="render"
        id="view-transition-render-blocker"
      >
    {% endif %}

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Red+Hat+Text:ital,wght@0,300..700;1,300..700&display=swap" rel="stylesheet">

    {% style %}

      body{
        background-color: #F4EFE8;
      }

      :root {
        {% if settings.openrunde_font_usage == 'body_heading' or settings.openrunde_font_usage == 'body_only' %}
          --main-font-stack: 'Red Hat Text', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
          --font-body--family: var(--main-font-stack);
          --font-subheading--family: var(--main-font-stack);
          --font-accent--family: var(--main-font-stack);
        {% endif %}
        {% if settings.openrunde_font_usage == 'body_heading' or settings.openrunde_font_usage == 'heading_only' %}
          --heading-font-stack: 'Red Hat Text', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
          --font-heading--family: var(--heading-font-stack);
        {% endif %}
      }
    {% endstyle %}
  </head>

  <body class="page-width-{{ settings.page_width }} landing-layout">
    {%- comment -%}
      Layout per le landing staccate dal sito (ADV): niente menu, ricerca, carrello
      o footer con link. Solo il logo (non cliccabile) e le informative legali.
    {%- endcomment -%}
    <style>
      .ll-head{display:flex;justify-content:center;align-items:center;padding:22px 20px 0}
      .ll-head img{height:{{ settings.logo_height | default: 36 }}px;width:auto;display:block}
      .ll-foot{max-width:1180px;margin:0 auto;padding:8px 20px 40px;text-align:center;font-size:13px;line-height:1.7;color:#706B65;font-family:var(--font-body--family)}
      .ll-foot a{color:inherit}
      .ll-foot nav{display:flex;flex-wrap:wrap;justify-content:center;gap:4px 16px;margin-top:6px}
      @media (max-width:749px){.ll-head img{height:{{ settings.logo_height_mobile | default: 28 }}px}}
    </style>
    <header class="ll-head">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 400 | image_tag: alt: shop.name, loading: 'eager' }}
      {%- else -%}
        <span style="font-weight:800;font-size:24px">{{ shop.name }}</span>
      {%- endif -%}
    </header>

    <main id="MainContent" class="content-for-layout" role="main" data-template="{{ template }}">
      {{ content_for_layout }}
    </main>

    <footer class="ll-foot">
      <div>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</div>
      <nav aria-label="Informative">
        {%- for policy in shop.policies -%}
          {%- if policy != blank -%}<a href="{{ policy.url }}">{{ policy.title }}</a>{%- endif -%}
        {%- endfor -%}
      </nav>
    </footer>
  </body>
</html>
