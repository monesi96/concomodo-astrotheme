<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    {% if settings.transition_to_main_product or settings.page_transition_enabled %}
      <link
        rel="expect"
        href="#MainContent"
        blocking="render"
        id="view-transition-render-blocker"
      >
    {% endif %}

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Red+Hat+Text:ital,wght@0,300..700;1,300..700&display=swap" rel="stylesheet">

    {% style %}

      body{
        background-color: #F4EFE8;
      }

      :root {
        {% if settings.openrunde_font_usage == 'body_heading' or settings.openrunde_font_usage == 'body_only' %}
          --main-font-stack: 'Red Hat Text', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
          --font-body--family: var(--main-font-stack);
          --font-subheading--family: var(--main-font-stack);
          --font-accent--family: var(--main-font-stack);
        {% endif %}
        {% if settings.openrunde_font_usage == 'body_heading' or settings.openrunde_font_usage == 'heading_only' %}
          --heading-font-stack: 'Red Hat Text', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
          --font-heading--family: var(--heading-font-stack);
        {% endif %}
      }
    {% endstyle %}

    <!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=AW-18544052229">
</script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'AW-18544052229');
</script>

  {%- comment -%}
      Allineamento uniforme delle sezioni (Concomodo).
      1. Bordo esterno: riquadri, foto, card e testi partono dal margine pagina del tema.
      2. Rientro unico dentro i riquadri colorati: --cc-pad (20px mobile, 48px desktop).
      3. Spazio unico tra le card: --cc-gap (12px mobile, 16px desktop).
      Per ora attivo solo in homepage: per estenderlo a tutto il sito togli la condizione template.name == 'index'.
    {%- endcomment -%}
    {%- if template.name == 'index' -%}
      <style id="cc-allineamento">
        :root {
          --cc-pad: clamp(20px, 4vw, 48px);
          --cc-gap: 16px;
        }

        @media screen and (max-width: 749px) {
          :root {
            --cc-gap: 12px;
          }
        }

        /* 1. Bordo esterno */
        #MainContent > .shopify-section > .section {
          --padding-inline-start: 0px !important;
          --padding-inline-end: 0px !important;
        }

        .made-italy__inner,
        .made-italy__flag,
        .rev5__panel,
        .qcompare__grid,
        .contact-cards__grid {
          max-width: none !important;
        }

        @media screen and (max-width: 599px) {
          .qcompare__grid {
            padding-inline: 0 !important;
            scroll-padding-inline: 0 !important;
          }
        }

        /* 2. Rientro dentro i riquadri */
        .whycc__panel {
          padding-inline: var(--cc-pad) !important;
        }

        .whycc__track,
        .whycc--label-horizontal .whycc__label {
          padding-inline-end: 0 !important;
        }

        .rev5__head,
        .rev5__note {
          padding-inline: var(--cc-pad) !important;
        }

        .rev5__viewport {
          margin-inline: var(--cc-pad) !important;
        }

        [id$='__section_6mPHiF'] .custom-section-content > .layout-panel-flex > .group-block {
          --padding-inline-start: var(--cc-pad) !important;
          --padding-inline-end: var(--cc-pad) !important;
          padding-inline: var(--cc-pad) !important;
        }

        /* 3. Spazio tra le card */
        .whycc__track,
        .qcompare__grid,
        .contact-cards__grid,
        [id$='__collection_list_hwFndy'] slideshow-slides {
          gap: var(--cc-gap) !important;
        }

        .made-italy__carousel {
          --mi-gap: var(--cc-gap) !important;
        }

        .rev5__card {
          margin-inline-end: var(--cc-gap) !important;
        }

        @media screen and (min-width: 750px) {
          [id$='__collection_list_hwFndy'] .resource-list__carousel .resource-list__slide {
            width: calc((100% - 2 * var(--cc-gap)) / 3) !important;
            margin-right: 0 !important;
          }
        }
      </style>
    {%- endif -%}
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <script>
      // Inline header height calculation to prevent layout shift
      // Note: Updates in calculateHeaderGroupHeight() and updateTransparentHeaderOffset()utilities.js should be kept in sync with this function
      (function setHeaderHeighCustomProperties() {
        /*
         * Header calculation functions for maintaining CSS variables
         * Mimic calculateHeaderGroupHeight() in utilities.js
         */
        const header = document.querySelector('header-component');
        const headerGroup = document.querySelector('#header-group');
        const hasHeaderSection = headerGroup?.querySelector('.header-section');

        if (!header || !headerGroup) return;

        const headerHeight = header.offsetHeight;

        // Calculate the total height of the header group
        let headerGroupHeight = 0;
        const children = headerGroup.children;
        for (let i = 0; i < children.length; i++) {
          const element = children[i];
          if (element === header || !(element instanceof HTMLElement)) continue;
          headerGroupHeight += element.offsetHeight;
        }

        // Check for transparent header special case
        if (header.hasAttribute('transparent') && header.parentElement?.nextElementSibling) {
          headerGroupHeight += headerHeight;
        }

        // Set CSS variables
        document.body.style.setProperty('--header-height', `${headerHeight}px`);
        document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);

        /**
         * Updates CSS custom properties for transparent header offset calculation
         * Mimic updateTransparentHeaderOffset() in utilities.js
         */

        if (!hasHeaderSection || !header?.hasAttribute('transparent')) {
          document.body.style.setProperty('--transparent-header-offset-boolean', '0');
          return;
        }

        const hasImmediateSection = hasHeaderSection.nextElementSibling?.classList.contains('shopify-section');

        const shouldApplyOffset = !hasImmediateSection ? '1' : '0';
        document.body.style.setProperty('--transparent-header-offset-boolean', shouldApplyOffset);
      })();
    </script>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}
  {%- comment -%}
  Curve tra sezioni.
  Quando una sezione ha uno sfondo di colore diverso da quella precedente, arrotonda
  i suoi angoli superiori e mostra negli spigoli il colore della sezione precedente
  (stesso effetto di newsletter e footer).
  Salta le sezioni già arrotondate e quelle con sfondo a immagine o sfumatura.
{%- endcomment -%}
<style>
  .cc-curve-top {
    position: relative;
    z-index: 0;
    isolation: isolate;
    background-color: var(--cc-curve-prev);
  }

  .cc-curve-top > .section-background,
  .cc-curve-top > .section {
    border-top-left-radius: var(--cc-curve-radius, 30px);
    border-top-right-radius: var(--cc-curve-radius, 30px);
  }
</style>
<script>
  (function () {
    function isTransparent(c) {
      return !c || c === 'transparent' || /^rgba\(.*,\s*0\)$/.test(c);
    }

    function pageColor() {
      var c = getComputedStyle(document.body).backgroundColor;
      return isTransparent(c) ? 'rgb(255, 255, 255)' : c;
    }

    function read(sec, fallback) {
      if (sec.offsetHeight === 0 || getComputedStyle(sec).position === 'fixed') return null;
      var el =
        sec.querySelector(':scope > .section-background') ||
        sec.querySelector(':scope > .section') ||
        sec.firstElementChild;
      if (!el) return { color: fallback, image: false, top: false, bottom: false };
      var cs = getComputedStyle(el);
      return {
        color: isTransparent(cs.backgroundColor) ? fallback : cs.backgroundColor,
        image: cs.backgroundImage !== 'none',
        top: parseFloat(cs.borderTopLeftRadius) > 0,
        bottom: parseFloat(cs.borderBottomLeftRadius) > 0
      };
    }

    function run() {
      var sections = Array.prototype.slice.call(
        document.querySelectorAll('#MainContent > .shopify-section, body > .shopify-section')
      );

      // 1. pulizia
      sections.forEach(function (sec) {
        sec.classList.remove('cc-curve-top');
        sec.style.removeProperty('--cc-curve-prev');
      });

      // 2. solo letture (evita ricalcoli di layout ripetuti)
      var fallback = pageColor();
      var data = sections.map(function (sec) {
        return read(sec, fallback);
      });

      // 3. solo scritture
      var prev = null;
      data.forEach(function (cur, i) {
        if (!cur) return;
        if (prev && !prev.image && !cur.image && !prev.bottom && !cur.top && cur.color !== prev.color) {
          sections[i].classList.add('cc-curve-top');
          sections[i].style.setProperty('--cc-curve-prev', prev.color);
        }
        prev = cur;
      });
    }

    var timer;
    function schedule() {
      clearTimeout(timer);
      timer = setTimeout(run, 50);
    }

    run();
    window.addEventListener('load', run);
    window.addEventListener('resize', schedule);
    ['shopify:section:load', 'shopify:section:unload', 'shopify:section:reorder'].forEach(function (evt) {
      document.addEventListener(evt, schedule);
    });
  })();
</script>

</body>
</html>
