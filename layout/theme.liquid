<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    {% if settings.transition_to_main_product or settings.page_transition_enabled %}
      <link
        rel="expect"
        href="#MainContent"
        blocking="render"
        id="view-transition-render-blocker"
      >
    {% endif %}

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Red+Hat+Text:ital,wght@0,300..700;1,300..700&display=swap" rel="stylesheet">

    {% style %}

      body{
        background-color: #F4EFE8;
      }

      :root {
        {% if settings.openrunde_font_usage == 'body_heading' or settings.openrunde_font_usage == 'body_only' %}
          --main-font-stack: 'Red Hat Text', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
          --font-body--family: var(--main-font-stack);
          --font-subheading--family: var(--main-font-stack);
          --font-accent--family: var(--main-font-stack);
        {% endif %}
        {% if settings.openrunde_font_usage == 'body_heading' or settings.openrunde_font_usage == 'heading_only' %}
          --heading-font-stack: 'Red Hat Text', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
          --font-heading--family: var(--heading-font-stack);
        {% endif %}
      }
    {% endstyle %}

    <!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=AW-18544052229">
</script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'AW-18544052229');
</script>

  {%- comment -%}
      Allineamento uniforme delle sezioni (Concomodo), su tutto il sito.
      1. Bordo esterno: riquadri, foto, card e testi partono dal margine pagina del tema (--page-margin).
      2. Rientro unico dentro i riquadri colorati: --cc-pad (20px mobile, 48px desktop).
      3. Spazio unico tra le card: --cc-gap (12px mobile, 16px desktop).
    {%- endcomment -%}
    <style id="cc-allineamento">
      :root {
        --cc-pad: clamp(20px, 4vw, 48px);
        --cc-gap: 16px;
      }

      @media screen and (max-width: 749px) {
        :root {
          --cc-gap: 12px;
        }
      }

      /* 1. Bordo esterno */
      /* Sezioni ristrette con CSS personalizzato (max-width + margin auto): tornano sul margine pagina */
      #MainContent > .shopify-section > div {
        max-width: none !important;
      }

      #MainContent > .shopify-section > .section {
        margin-inline: 0 !important;
      }

      /* FAQ, accordion e sezioni personalizzate impostate a tutta larghezza: stesso margine pagina delle altre */
      #MainContent > .shopify-section > .section--full-width:has(.accordion),
      #MainContent > .shopify-section > .section--full-width:is(.qcompare, .rev5, .made-italy, .whycc, .contact-cards) {
        padding-inline: var(--page-margin) !important;
      }

      .custom-section-content,
      .made-italy__inner,
      .made-italy__flag,
      .rev5__panel,
      .qcompare__grid,
      .contact-cards__grid {
        max-width: none !important;
      }

      .made-italy__inner,
      .rev5__panel,
      .qcompare__grid,
      .contact-cards__grid,
      .mattress-comparison__card,
      .section-resource-list__layout {
        margin-inline: 0 !important;
      }

      .mattress-comparison__card {
        max-width: none !important;
      }

      /* Gruppi senza sfondo che contengono FAQ o accordion: nessun rientro */
      .group-block:not([class*='color-']):has(> .group-block-content > .accordion) {
        --padding-inline-start: 0px !important;
        --padding-inline-end: 0px !important;
        padding-inline: 0 !important;
      }

      /* Landing Offerte di lancio */
      .ol {
        padding-inline: var(--page-margin) !important;
      }

      /* Rientri laterali impostati a mano nelle sezioni personalizzate */
      .section.made-italy,
      .section.rev5,
      .section.whycc,
      .section.qcompare,
      .section.contact-cards {
        --padding-inline-start: 0px !important;
        --padding-inline-end: 0px !important;
      }

      @media screen and (max-width: 599px) {
        .qcompare__grid {
          padding-inline: 0 !important;
          scroll-padding-inline: 0 !important;
        }
      }

      /* 2. Rientro dentro i riquadri */
      .whycc__panel {
        padding-inline: var(--cc-pad) !important;
      }

      .whycc__track,
      .whycc--label-horizontal .whycc__label {
        padding-inline-end: 0 !important;
      }

      .rev5__head,
      .rev5__note {
        padding-inline: var(--cc-pad) !important;
      }

      .rev5__viewport {
        margin-inline: var(--cc-pad) !important;
      }

      .mattress-comparison__card,
      .ol-hero {
        padding-inline: var(--cc-pad) !important;
      }

      /* Box colorati di Prova 100 notti + Quiz */
      :is([id$='__section_promo'], [id$='__section_XndPc9']) .group-block .group-block[class*='color-'] {
        --padding-inline-start: var(--cc-pad) !important;
        --padding-inline-end: var(--cc-pad) !important;
        padding-inline: var(--cc-pad) !important;
      }

      [id$='__section_6mPHiF'] .custom-section-content > .layout-panel-flex > .group-block {
        --padding-inline-start: var(--cc-pad) !important;
        --padding-inline-end: var(--cc-pad) !important;
        padding-inline: var(--cc-pad) !important;
      }

      /* 3. Spazio tra le card */
      .whycc__track,
      .qcompare__grid,
      .contact-cards__grid,
      .ol-grid,
      :is([id$='__section_promo'], [id$='__section_XndPc9']) .custom-section-content > .layout-panel-flex > .group-block > .group-block-content,
      .resource-list__carousel:has(.collection-card) slideshow-slides {
        gap: var(--cc-gap) !important;
      }

      .product-grid {
        column-gap: var(--cc-gap) !important;
      }

      .made-italy__carousel {
        --mi-gap: var(--cc-gap) !important;
      }

      .rev5__card {
        margin-inline-end: var(--cc-gap) !important;
      }

      @media screen and (min-width: 750px) {
        .resource-list__carousel:has(.collection-card) .resource-list__slide {
          width: calc((100% - 2 * var(--cc-gap)) / 3) !important;
          margin-right: 0 !important;
        }
      }
      /* 4. Caroselli a filo destro (come Better Nights): riquadro e card escono dal bordo destro dello schermo
         e si chiudono sul margine pagina solo a fine corsa */
      .whycc__panel {
        width: calc(100% + var(--page-margin)) !important;
        margin-inline-end: calc(-1 * var(--page-margin)) !important;
        padding-inline-end: 0 !important;
        border-start-end-radius: 0 !important;
        border-end-end-radius: 0 !important;
      }

      .whycc__track {
        display: flex !important;
        padding-inline-end: 0 !important;
        scroll-padding-inline-end: calc(var(--page-margin) + 20px);
        gap: 0 !important;
        overscroll-behavior-x: none;
        border-radius: 0 !important;
      }

      /* Spazio finale reale: Safari ignora il padding destro dei contenitori a scorrimento */
      .whycc__track::after {
        content: '';
        flex: 0 0 var(--page-margin);
      }

      .whycc__rail > :last-child {
        scroll-snap-align: end;
      }

      /* Azzurro dietro le card: copre lo spazio che si apre trascinando oltre la prima card */
      .whycc--label-vertical .whycc__track {
        background: linear-gradient(to right, var(--whycc-bg) 50%, transparent 50%);
      }

      @media screen and (max-width: 749px) {
        .whycc__track {
          scroll-padding-inline-end: calc(var(--page-margin) + 18px);
        }
      }

      .whycc__rail {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: 74vw;
        gap: var(--cc-gap);
        width: max-content;
      }

      @media screen and (min-width: 750px) {
        .whycc__rail {
          grid-auto-columns: clamp(260px, 26vw, 380px);
        }
      }

      .whycc--label-horizontal .whycc__label {
        padding-inline-end: var(--cc-pad) !important;
      }

      /* Etichetta verticale: l'azzurro scorre con le card e si chiude dopo l'ultima.
         L'etichetta e' ruotata di 180 gradi, per questo padding e angoli sono invertiti. */
      .whycc--label-vertical .whycc__panel {
        padding: 0 !important;
        gap: 0 !important;
        background: none !important;
        border-radius: 0 !important;
      }

      .whycc--label-vertical .whycc__label {
        padding: 20px var(--cc-pad) 20px var(--whycc-gap);
        background: var(--whycc-bg);
        border-radius: 0 var(--whycc-radius) var(--whycc-radius) 0;
      }

      .whycc--label-vertical .whycc__rail {
        padding: 20px 20px 20px 0;
        background: var(--whycc-bg);
        border-radius: 0 var(--whycc-radius) var(--whycc-radius) 0;
      }

      @media screen and (max-width: 749px) {
        .whycc--label-vertical .whycc__label {
          padding-block: 18px;
        }

        .whycc--label-vertical .whycc__rail {
          padding: 18px 18px 18px 0;
        }
      }

      .made-italy:not(.made-italy--media-left) .made-italy__viewport {
        margin-inline-end: calc(-1 * var(--page-margin));
      }

      /* Taglio arrotondato delle card quando scorrono sotto l'etichetta (stesso raggio delle card) */
      .whycc--label-vertical .whycc__panel {
        background: linear-gradient(to right, var(--whycc-bg) 50%, transparent 50%) !important;
        border-radius: var(--whycc-radius) 0 0 var(--whycc-radius) !important;
      }

      .whycc--label-vertical .whycc__track {
        --cc-r: round(calc(var(--whycc-radius) * 0.7), 1px);
        --cc-pb: 20px;
        --cc-mask:
          linear-gradient(#000 0 0) right / calc(100% - var(--cc-r)) 100% no-repeat,
          linear-gradient(#000 0 0) left top / var(--cc-r) var(--cc-pb) no-repeat,
          linear-gradient(#000 0 0) left bottom / var(--cc-r) var(--cc-pb) no-repeat,
          linear-gradient(#000 0 0) left center / var(--cc-r) calc(100% - 2 * var(--cc-pb) - 2 * var(--cc-r)) no-repeat,
          radial-gradient(circle at 100% 100%, #000 calc(var(--cc-r) - 0.5px), #0000 var(--cc-r)) left 0 top var(--cc-pb) / var(--cc-r) var(--cc-r) no-repeat,
          radial-gradient(circle at 100% 0, #000 calc(var(--cc-r) - 0.5px), #0000 var(--cc-r)) left 0 bottom var(--cc-pb) / var(--cc-r) var(--cc-r) no-repeat;
        -webkit-mask: var(--cc-mask);
        mask: var(--cc-mask);
      }

      @media screen and (max-width: 749px) {
        .whycc--label-vertical .whycc__track {
          --cc-pb: 18px;
        }
      }

      /* 5. Comparatore su mobile: carosello a filo schermo. Parte dal margine, le card escono a destra
         e scorrono fino al bordo sinistro; a fine corsa l'ultima si ferma sul margine destro */
      @media screen and (max-width: 599px) {
        .qcompare__grid {
          display: flex !important;
          margin-inline: calc(-1 * var(--page-margin)) !important;
          padding-inline: var(--page-margin) 0 !important;
          scroll-padding-inline: var(--page-margin) !important;
        }

        .qcompare__grid > .qcompare__card {
          flex: 0 0 min(calc((100vw - 2 * var(--page-margin)) * 0.8), 330px);
        }

        .qcompare__grid > .qcompare__card:last-of-type {
          scroll-snap-align: end;
        }

        .qcompare__grid::after {
          content: '';
          flex: 0 0 calc(var(--page-margin) - var(--cc-gap));
        }
      }
    </style>
  <style id="cc-tipografia">
      /* 6. Titoli e sottotitoli di sezione: una sola scala su tutto il sito.
         Titolo 32px su mobile fino a 48px su desktop, base peso 500, parte chiave in <strong> peso 700.
         Testo introduttivo 16px, interlinea 1.6. Hero, card e titoli prodotto restano come sono. */
      :root {
        --cc-title: clamp(2rem, 1.35rem + 2.2vw, 3rem);
      }

      :is(.made-italy__heading, .rev5__heading, .qcompare__heading, .contact-cards__heading, .mattress-layers__heading, .mattress-comparison__heading, .comodi20__heading, .bundle-builder__heading, .installment-payments__heading),
      #MainContent :is([class*='__text_bjkEqE'], [class*='__text_7yjNEp'], [class*='__text_7qQVdD'], [class*='__text_R84Ug6'], [class*='__faq_h '], [class*='__cf_heading '], [class*='__form_heading '], [class*='__blog_banner_title '], [class*='__coll_header_text '], [class*='__text_mtnBCE'], [class*='__text_9KQaTd']) > * {
        font-size: var(--cc-title) !important;
        font-weight: 500 !important;
        line-height: 1.08 !important;
        letter-spacing: -0.03em !important;
      }

      :is(.made-italy__heading, .rev5__heading, .qcompare__heading, .contact-cards__heading, .mattress-layers__heading, .mattress-comparison__heading, .comodi20__heading, .bundle-builder__heading, .installment-payments__heading) strong,
      #MainContent :is([class*='__text_bjkEqE'], [class*='__text_7yjNEp'], [class*='__text_7qQVdD'], [class*='__text_R84Ug6'], [class*='__faq_h '], [class*='__cf_heading '], [class*='__form_heading '], [class*='__blog_banner_title '], [class*='__coll_header_text '], [class*='__text_mtnBCE'], [class*='__text_9KQaTd']) strong {
        font-weight: 700 !important;
      }

      :is(.made-italy__text, .rev5__sub, .qcompare__subheading, .contact-cards__subheading, .mattress-layers__subheading, .comodi20__subheading, .bundle-builder__subheading, .installment-payments__subheading),
      #MainContent [class*='__text_xDkV9M'] > * {
        font-size: 1rem !important;
        line-height: 1.6 !important;
      }
    </style>
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <script>
      // Inline header height calculation to prevent layout shift
      // Note: Updates in calculateHeaderGroupHeight() and updateTransparentHeaderOffset()utilities.js should be kept in sync with this function
      (function setHeaderHeighCustomProperties() {
        /*
         * Header calculation functions for maintaining CSS variables
         * Mimic calculateHeaderGroupHeight() in utilities.js
         */
        const header = document.querySelector('header-component');
        const headerGroup = document.querySelector('#header-group');
        const hasHeaderSection = headerGroup?.querySelector('.header-section');

        if (!header || !headerGroup) return;

        const headerHeight = header.offsetHeight;

        // Calculate the total height of the header group
        let headerGroupHeight = 0;
        const children = headerGroup.children;
        for (let i = 0; i < children.length; i++) {
          const element = children[i];
          if (element === header || !(element instanceof HTMLElement)) continue;
          headerGroupHeight += element.offsetHeight;
        }

        // Check for transparent header special case
        if (header.hasAttribute('transparent') && header.parentElement?.nextElementSibling) {
          headerGroupHeight += headerHeight;
        }

        // Set CSS variables
        document.body.style.setProperty('--header-height', `${headerHeight}px`);
        document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);

        /**
         * Updates CSS custom properties for transparent header offset calculation
         * Mimic updateTransparentHeaderOffset() in utilities.js
         */

        if (!hasHeaderSection || !header?.hasAttribute('transparent')) {
          document.body.style.setProperty('--transparent-header-offset-boolean', '0');
          return;
        }

        const hasImmediateSection = hasHeaderSection.nextElementSibling?.classList.contains('shopify-section');

        const shouldApplyOffset = !hasImmediateSection ? '1' : '0';
        document.body.style.setProperty('--transparent-header-offset-boolean', shouldApplyOffset);
      })();
    </script>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}
  {%- comment -%}
  Curve tra sezioni.
  Quando una sezione ha uno sfondo di colore diverso da quella precedente, arrotonda
  i suoi angoli superiori e mostra negli spigoli il colore della sezione precedente
  (stesso effetto di newsletter e footer).
  Salta le sezioni già arrotondate e quelle con sfondo a immagine o sfumatura.
{%- endcomment -%}
<style>
  .cc-curve-top {
    position: relative;
    z-index: 0;
    isolation: isolate;
    background-color: var(--cc-curve-prev);
  }

  .cc-curve-top > .section-background,
  .cc-curve-top > .section {
    border-top-left-radius: var(--cc-curve-radius, 30px);
    border-top-right-radius: var(--cc-curve-radius, 30px);
  }
</style>
<script>
  (function () {
    function isTransparent(c) {
      return !c || c === 'transparent' || /^rgba\(.*,\s*0\)$/.test(c);
    }

    function pageColor() {
      var c = getComputedStyle(document.body).backgroundColor;
      return isTransparent(c) ? 'rgb(255, 255, 255)' : c;
    }

    function read(sec, fallback) {
      if (sec.offsetHeight === 0 || getComputedStyle(sec).position === 'fixed') return null;
      var el =
        sec.querySelector(':scope > .section-background') ||
        sec.querySelector(':scope > .section') ||
        sec.firstElementChild;
      if (!el) return { color: fallback, image: false, top: false, bottom: false };
      var cs = getComputedStyle(el);
      return {
        color: isTransparent(cs.backgroundColor) ? fallback : cs.backgroundColor,
        image: cs.backgroundImage !== 'none',
        top: parseFloat(cs.borderTopLeftRadius) > 0,
        bottom: parseFloat(cs.borderBottomLeftRadius) > 0
      };
    }

    function run() {
      var sections = Array.prototype.slice.call(
        document.querySelectorAll('#MainContent > .shopify-section, body > .shopify-section')
      );

      // 1. pulizia
      sections.forEach(function (sec) {
        sec.classList.remove('cc-curve-top');
        sec.style.removeProperty('--cc-curve-prev');
      });

      // 2. solo letture (evita ricalcoli di layout ripetuti)
      var fallback = pageColor();
      var data = sections.map(function (sec) {
        return read(sec, fallback);
      });

      // 3. solo scritture
      var prev = null;
      data.forEach(function (cur, i) {
        if (!cur) return;
        if (prev && !prev.image && !cur.image && !prev.bottom && !cur.top && cur.color !== prev.color) {
          sections[i].classList.add('cc-curve-top');
          sections[i].style.setProperty('--cc-curve-prev', prev.color);
        }
        prev = cur;
      });
    }

    var timer;
    function schedule() {
      clearTimeout(timer);
      timer = setTimeout(run, 50);
    }

    run();
    window.addEventListener('load', run);
    window.addEventListener('resize', schedule);
    ['shopify:section:load', 'shopify:section:unload', 'shopify:section:reorder'].forEach(function (evt) {
      document.addEventListener(evt, schedule);
    });
  })();
</script>

</body>
</html>
