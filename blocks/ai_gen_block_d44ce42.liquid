{% doc %}
  @prompt
    blocco nel menu footer, tra logo e dati azienda, con titolo e icona "hai bisogno di noi?" e i contatti: mail info@concomodo.it con link mailto:
    telefono e whatsapp +39 3937105726 con links tel: e wa.me e icone, assicurati che il colore del testo e delle icone sia leggibile, ma perché ha colore diverso dal footer tutto il blocco piuttosto che mettere scritte e icone chiare???????, imposta i testi di email, telefono e WhatsApp alla stessa dimensione dei link del footer: 18 px (1,125 rem). Usa il font del corpo del tema, ereditandolo dalle impostazioni globali. Mantieni il titolo “Hai bisogno di noi?” in grassetto, senza cambiarne la dimensione. Non modificare testi, collegamenti, icone, colori o spaziature. Limita la modifica a questo blocco e aggiungi un controllo per la dimensione dei contatti, così da poterla regolare in futuro dall’editor.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-footer-contact-{{ ai_gen_id }} { display:block; width:{{ block.settings.desktop_width_percent }}%; max-width:100%; box-sizing:border-box; padding:0; background:transparent; color:#ffffff; font-family:inherit; }
  .ai-footer-contact-{{ ai_gen_id }}__heading { display:flex; align-items:center; gap:10px; margin:0 0 14px; color:#ffffff; font:inherit; font-weight:600; font-size:18px; line-height:1.3; }
  .ai-footer-contact-{{ ai_gen_id }}__heading svg { width:21px; height:21px; flex:0 0 21px; stroke:currentColor; }
  .ai-footer-contact-{{ ai_gen_id }}__list { display:grid; gap:10px; }
  .ai-footer-contact-{{ ai_gen_id }}__link { display:inline-flex; align-items:center; gap:10px; width:fit-content; max-width:100%; color:#ffffff; font-family:inherit; font-size:{{ block.settings.contact_font_size }}px; line-height:1.5; text-decoration:underline; text-underline-offset:3px; overflow-wrap:anywhere; }
  .ai-footer-contact-{{ ai_gen_id }}__link:hover { color:#f4efe8; text-decoration-thickness:2px; }
  .ai-footer-contact-{{ ai_gen_id }}__link:focus-visible { outline:2px solid #ffffff; outline-offset:4px; border-radius:2px; }
  .ai-footer-contact-{{ ai_gen_id }}__link svg { width:18px; height:18px; flex:0 0 18px; stroke:currentColor; }
{% endstyle %}
<div class="ai-footer-contact-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <h2 class="ai-footer-contact-{{ ai_gen_id }}__heading"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 13v-2a8 8 0 0 1 16 0v2"/><path d="M4 13h3v6H6a2 2 0 0 1-2-2v-4Zm16 0h-3v6h1a2 2 0 0 0 2-2v-4Z"/><path d="M17 19c-.7 1.2-2 2-4 2h-1"/></svg><span>{{ block.settings.heading | escape }}</span></h2>
  <div class="ai-footer-contact-{{ ai_gen_id }}__list">
    <a class="ai-footer-contact-{{ ai_gen_id }}__link" href="mailto:{{ block.settings.email | escape }}"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg><span>{{ block.settings.email | escape }}</span></a>
    <a class="ai-footer-contact-{{ ai_gen_id }}__link" href="tel:{{ block.settings.phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | escape }}"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 16.5v3a2 2 0 0 1-2.2 2A19.8 19.8 0 0 1 10.2 18a19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 1.9 3.2 2 2 0 0 1 3.9 1h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L7.8 9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 .9 2.6Z"/></svg><span>{{ block.settings.phone | escape }}</span></a>
    <a class="ai-footer-contact-{{ ai_gen_id }}__link" href="https://wa.me/{{ block.settings.phone | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | escape }}" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp: {{ block.settings.phone | escape }} (si apre in una nuova scheda)"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20.5 11.5a8.5 8.5 0 0 1-12.6 7.4L3 20l1.2-4.7A8.5 8.5 0 1 1 20.5 11.5Z"/><path d="M8.5 8.2c.3-.5.6-.5.9-.5h.4c.2 0 .4.1.5.4l.7 1.7c.1.2.1.4-.1.6l-.5.6c-.2.2-.2.4 0 .6.5.9 1.2 1.6 2.1 2.1.2.1.4.1.6-.1l.7-.8c.2-.2.4-.2.6-.1l1.6.8c.2.1.3.3.3.5 0 .4-.2 1-.6 1.3-.4.4-1 .6-1.6.5-1-.1-2.3-.7-3.6-1.8-1.1-1-1.9-2.2-2.1-3.2-.2-1 .1-1.9.5-2.6Z"/></svg><span>WhatsApp</span></a>
  </div>
</div>
{% schema %}
{
  "name": "Contatti footer",
  "settings": [
    {"type":"header","content":"Contatti"},
    {"type":"text","id":"heading","label":"Titolo","default":"Hai bisogno di noi?"},
    {"type":"text","id":"email","label":"Email","default":"info@concomodo.it"},
    {"type":"text","id":"phone","label":"Telefono e WhatsApp","default":"+39 3937105726"},
    {"type":"range","id":"contact_font_size","label":"Dimensione contatti","min":12,"max":24,"step":1,"unit":"px","default":18},
    {"type":"range","id":"desktop_width_percent","label":"Larghezza desktop","min":50,"max":100,"step":5,"unit":"%","default":100}
  ],
  "presets": [{"name":"Contatti footer"}],
  "tag": null,
  "class": "footer-contact-block"
}
{% endschema %}