{%- doc -%}
  Blocco con il messaggio promozionale ufficiale HeyLight Dilazione.
  Le condizioni (min, max, rate, rata minima) sono nello snippet heylight-widget.
{%- enddoc -%}

<div class="heylight-widget-block spacing-style" style="{% render 'spacing-style', settings: block.settings %}" {{ block.shopify_attributes }}>
  {%- render 'heylight-widget', product_resource: closest.product -%}
</div>

{% stylesheet %}
  heylight-widget {
    display: block;
  }

  heylight-widget[hidden] {
    display: none;
  }

  .heylight-widget-block {
    width: 100%;
  }

  .heylight-widget-block:not(:has(heylight-widget:not([hidden]))) {
    display: none;
  }

  /* Concomodo: niente padding interno del widget, testo che va a capo nella card */
  .heylight-widget-block .heyLight-inline {
    padding-block: 0 !important;
    max-width: 100%;
  }

  .heylight-widget-block .summary-row {
    gap: 12px;
    max-width: 100%;
  }

  /* Concomodo: messaggio HeyLight più evidente */
  .heylight-widget-block .heyLight-inline {
    width: 100% !important;
    max-width: none !important;
    box-sizing: border-box;
    background: #f4f1ec;
    border-radius: 12px;
    padding: 14px 16px !important;
  }

  .heylight-widget-block .heyLight-inline .summary-row {
    width: 100%;
    font-size: 15px;
    line-height: 1.35;
    align-items: center;
    gap: 14px;
  }

  .heylight-widget-block .heyLightLogo {
    width: 88px !important;
    height: 32px !important;
    flex: 0 0 88px;
    background-size: contain !important;
    background-position: center !important;
    background-repeat: no-repeat !important;
  }

  .heylight-widget-block .heyLight-inline .summary-details,
  .heylight-widget-block .heyLight-inline .summary-details span {
    font-size: 15px;
    line-height: 1.35;
    color: #2b2b2b;
  }

  .heylight-widget-block .heyLight-inline .summary-details b {
    font-size: 19px;
    font-weight: 700;
    color: #000;
  }

  .heylight-widget-block .heidi-trigger-button,
  .heylight-widget-block .heidi-trigger-button span {
    font-size: 14px;
    line-height: 1.4;
    font-weight: 600;
  }

  .heylight-widget-block .summary-row > *:not(.heyLightLogo) {
    min-width: 0;
  }

  .heylight-widget-block .summary-details,
  .heylight-widget-block .summary-details span {
    flex-wrap: wrap;
    white-space: normal;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Messaggio HeyLight",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Messaggio ufficiale HeyLight: rata e numero di rate calcolati dal widget HeyLight sul prezzo della variante."
    },
    { "type": "range", "id": "padding-block-start", "label": "Sopra", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding-block-end", "label": "Sotto", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 0 }
  ],
  "presets": [
    {
      "name": "Messaggio HeyLight",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
